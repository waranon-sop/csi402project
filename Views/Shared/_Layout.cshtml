<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - เสื้อผ้า.com</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/waranon_csi402.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body style="font-family: 'Prompt', sans-serif;" class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm sticky-top py-2">
            <div class="container">
                <!-- Brand -->
                <a class="navbar-brand fw-bold text-dark d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="bg-primary text-white rounded p-2 me-2 d-inline-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="fa-solid fa-shirt"></i>
                    </span>
                    <span class="fs-4">เสื้อผ้า<span class="text-primary">.com</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <!-- เมนูด้านซ้าย -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-house me-1 text-secondary"></i> หน้าแรก
                            </a>
                        </li>
                    </ul>

                    <!-- เมนูด้านขวา (ตะกร้า & บัญชีผู้ใช้) -->
                    <div class="d-flex align-items-center gap-2">
                        <!-- ปุ่มตะกร้าสินค้า -->
                        <a href="javascript:void(0);" onclick="alert('ระบบตะกร้าสินค้าจะเปิดใช้งานในขั้นตอนถัดไปครับ');" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                            <i class="fa-solid fa-cart-shopping me-1"></i> ตะกร้า
                            <span class="badge bg-danger rounded-pill ms-1">0</span>
                        </a>

                        @if (TempData.Peek("Name") != null)
                        {
                            <!-- เมนูผู้ใช้งานที่ล็อกอินแล้ว -->
                            <div class="dropdown">
                                <button class="btn btn-primary btn-sm rounded-pill dropdown-toggle px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-user me-1"></i> @TempData.Peek("Name")
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                    <li class="dropdown-header small">สิทธิ์: @(TempData.Peek("Role") ?? "Customer")</li>
                                    @if (TempData.Peek("Role")?.ToString() == "Admin")
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                                                <i class="fa-solid fa-shield-halved text-primary me-2"></i>ระบบจัดการหลังบ้าน (Admin)
                                            </a>
                                        </li>
                                    }
                                    else if (TempData.Peek("Role")?.ToString() == "Staff")
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Staff" asp-action="Index">
                                                <i class="fa-solid fa-boxes-packing text-info me-2"></i>ระบบจัดการคลัง (Staff)
                                            </a>
                                        </li>
                                    }
                                    else if (TempData.Peek("Role")?.ToString() == "Accounting")
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Accounting" asp-action="Index">
                                                <i class="fa-solid fa-file-invoice-dollar text-success me-2"></i>ระบบฝ่ายบัญชี (Accounting)
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Login">
                                            <i class="fa-solid fa-right-from-bracket me-2"></i>ออกจากระบบ
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <!-- เมนูเข้าสู่ระบบ / สมัครสมาชิก -->
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                เข้าสู่ระบบ
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm rounded-pill px-3">
                                สมัครสมาชิก
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-top text-muted py-4 mt-auto">
        <div class="container text-center">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-start mb-2 mb-md-0">
                    <span class="fw-bold text-dark"><i class="fa-solid fa-shirt text-primary me-1"></i> เสื้อผ้า.com</span> 
                    - ระบบพาณิชย์อิเล็กทรอนิกส์สำหรับซื้อขายเสื้อผ้าออนไลน์
                </div>
                <div class="col-md-6 text-md-end small">
                    &copy; 2026 waranon_csi402 - สาขาวิทยาการคอมพิวเตอร์และนวัตกรรมการพัฒนาซอฟต์แวร์
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
