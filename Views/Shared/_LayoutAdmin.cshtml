<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/waranon_csi402.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    @RenderSection("Styles", required: false)
</head>

<body style="font-family: 'Prompt', sans-serif;">

    <div class="d-flex min-vh-100">

        <!-- Sidebar (Desktop) — ซ่อนบนมือถือ -->
        <nav class="d-none d-lg-flex flex-column bg-dark text-white p-3" style="width: 260px;">
            <partial name="_SidebarAdmin" />
        </nav>

        <!-- Sidebar (Mobile) — Offcanvas -->
        <div class="offcanvas offcanvas-start bg-dark text-white" tabindex="-1" id="sidebarOffcanvas">
            <div class="offcanvas-header border-bottom border-secondary">
                <h5 class="offcanvas-title text-white">เมนู</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column p-3">
                <partial name="_SidebarAdmin" />
            </div>
        </div>

        <!-- Main Content -->
        <div class="flex-grow-1 d-flex flex-column">
            <!-- Top Navbar -->
            <nav class="navbar navbar-light bg-white shadow-sm px-3 px-lg-4 py-2">
                <!-- ปุ่ม Toggle Sidebar (มือถือ) -->
                <button class="btn btn-outline-dark d-lg-none me-2" type="button" data-bs-toggle="offcanvas"
                        data-bs-target="#sidebarOffcanvas">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <span class="navbar-text fw-semibold text-dark">
                    <i class="fa-solid fa-shield-halved text-primary me-2"></i>ระบบจัดการ (Admin)
                </span>
                <div class="d-flex align-items-center">
                    <a class="text-dark me-3 position-relative" href="#">
                        <i class="fa-solid fa-bell"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                              style="font-size: 0.6rem;">5</span>
                    </a>
                    <a class="text-decoration-none text-dark small d-none d-sm-inline" asp-area="" asp-controller="Home"
                       asp-action="Index">
                        <i class="fa-solid fa-store me-1"></i>ไปหน้าร้าน
                    </a>
                </div>
            </nav>

            <!-- Page Content -->
            <main class="flex-grow-1 p-3 p-lg-4 bg-light">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="bg-white border-top text-center py-2 small text-muted">
                &copy; 2026 - เสื้อผ้า.com - Admin Panel
            </footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
