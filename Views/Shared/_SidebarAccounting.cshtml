@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentTab = Context.Request.Query["tab"].ToString().ToLower();
    
    bool isIndex = currentController == "Accounting" && (currentAction == "Index" || currentAction == "VerifySlip");
    bool isReport = currentController == "Accounting" && currentAction == "FinancialReport";
    bool isVerifyingTab = isIndex && (currentTab == "verifying" || string.IsNullOrEmpty(currentTab));
    bool isPaidTab = isIndex && currentTab == "paid";
    bool isInvalidTab = isIndex && currentTab == "invalid";
}

<!-- Sidebar Header -->
<div class="d-flex align-items-center mb-4 pb-3 border-bottom border-white border-opacity-10">
    <div class="bg-gradient bg-info text-dark rounded-3 p-2 me-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px;">
        <i class="fa-solid fa-file-invoice-dollar fs-4"></i>
    </div>
    <div>
        <h5 class="fw-bold mb-0 text-white" style="letter-spacing: -0.5px;">เสื้อผ้า<span class="text-info">.com</span></h5>
        <small class="text-info fw-semibold" style="font-size: 0.72rem; letter-spacing: 0.5px;">ฝ่ายบัญชีและการเงิน</small>
    </div>
</div>

<!-- Navigation Menu -->
<div class="d-flex flex-column mb-auto">
    <div class="text-uppercase text-white-50 fw-semibold mb-2" style="font-size: 0.7rem; letter-spacing: 0.5px;">คิวงานการเงิน</div>
    <ul class="nav flex-column mb-3 gap-1">
        <!-- 1. คิวงานตรวจสอบสลิปทั้งหมด -->
        <li class="nav-item">
            <a class="nav-link @(isIndex && currentTab == "all" ? "active bg-info text-dark fw-bold shadow-sm" : "text-white-50 hover-light") rounded-3 px-3 py-2" 
               asp-controller="Accounting" asp-action="Index" asp-route-tab="all">
                <i class="fa-solid fa-list-check me-2"></i>คิวงานทั้งหมด
            </a>
        </li>

        <!-- 2. รอตรวจสอบสลิป (Actionable) -->
        <li class="nav-item">
            <a class="nav-link @(isVerifyingTab ? "active bg-warning text-dark fw-bold shadow-sm" : "text-white-50 hover-light") rounded-3 px-3 py-2 d-flex align-items-center justify-content-between" 
               asp-controller="Accounting" asp-action="Index" asp-route-tab="verifying">
                <div>
                    <i class="fa-solid fa-clock-rotate-left me-2"></i>รอตรวจสลิป
                </div>
                <span class="badge @(isVerifyingTab ? "bg-dark text-white" : "bg-warning text-dark") rounded-pill">ด่วน</span>
            </a>
        </li>

        <!-- 3. รายการที่อนุมัติแล้ว (Paid) -->
        <li class="nav-item">
            <a class="nav-link @(isPaidTab ? "active bg-success text-white fw-bold shadow-sm" : "text-white-50 hover-light") rounded-3 px-3 py-2" 
               asp-controller="Accounting" asp-action="Index" asp-route-tab="paid">
                <i class="fa-solid fa-circle-check me-2"></i>อนุมัติแล้ว (Paid)
            </a>
        </li>

        <!-- 4. สลิปไม่ถูกต้อง (Invalid Slip) -->
        <li class="nav-item">
            <a class="nav-link @(isInvalidTab ? "active bg-danger text-white fw-bold shadow-sm" : "text-white-50 hover-light") rounded-3 px-3 py-2" 
               asp-controller="Accounting" asp-action="Index" asp-route-tab="invalid">
                <i class="fa-solid fa-circle-exclamation me-2"></i>สลิปไม่ถูกต้อง
            </a>
        </li>
    </ul>

    <div class="text-uppercase text-white-50 fw-semibold mb-2" style="font-size: 0.7rem; letter-spacing: 0.5px;">รายงาน</div>
    <ul class="nav flex-column mb-3 gap-1">
        <!-- 5. รายงานสรุปการเงิน -->
        <li class="nav-item">
            <a class="nav-link @(isReport ? "active bg-info text-dark fw-bold shadow-sm" : "text-white-50 hover-light") rounded-3 px-3 py-2" 
               asp-controller="Accounting" asp-action="FinancialReport">
                <i class="fa-solid fa-chart-pie me-2"></i>รายงานสรุปรายรับ
            </a>
        </li>
    </ul>

    <div class="text-uppercase text-white-50 fw-semibold mb-2" style="font-size: 0.7rem; letter-spacing: 0.5px;">ระบบอื่นที่เกี่ยวข้อง</div>
    <ul class="nav flex-column mb-2 gap-1">
        <li class="nav-item">
            <a class="nav-link text-white-50 hover-light rounded-3 px-3 py-2" asp-controller="Staff" asp-action="Index">
                <i class="fa-solid fa-boxes-packing me-2 text-success"></i>
                <span>ระบบคลังสินค้า (Staff)</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white-50 hover-light rounded-3 px-3 py-2" asp-controller="Admin" asp-action="Index">
                <i class="fa-solid fa-shield-halved me-2 text-primary"></i>
                <span>ระบบผู้ดูแล (Admin)</span>
            </a>
        </li>
        @await Html.PartialAsync("_NotificationBell", "sidebar")
        <li class="nav-item">
            <a class="nav-link text-white-50 hover-light rounded-3 px-3 py-2" asp-controller="Home" asp-action="Index" target="_blank">
                <i class="fa-solid fa-arrow-up-right-from-square me-2 text-info"></i>
                <span>เปิดดูหน้าร้าน</span>
            </a>
        </li>
    </ul>
</div>

<!-- Footer Profile -->
<div class="border-top border-white border-opacity-10 pt-3 mt-auto">
    <div class="p-2 rounded-3 bg-white bg-opacity-10 d-flex align-items-center mb-2">
        <div class="avatar-circle text-dark me-2 d-flex align-items-center justify-content-center rounded-circle bg-info fw-bold" 
             style="width: 38px; height: 38px; font-size: 0.9rem;">
            @(TempData.Peek("Name")?.ToString()?.Substring(0, 1) ?? "A")
        </div>
        <div class="overflow-hidden flex-grow-1" style="line-height: 1.2;">
            <div class="fw-semibold text-white small text-truncate">@(TempData.Peek("Name") ?? "ฝ่ายบัญชีการเงิน")</div>
            <span class="badge bg-info text-dark py-0 px-2" style="font-size: 0.65rem;">Accounting</span>
        </div>
    </div>

    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-light btn-sm w-100 rounded-pill py-1 text-white-50 hover-white" style="font-size: 0.8rem;">
        <i class="fa-solid fa-right-from-bracket me-1"></i>ออกจากระบบ
    </a>
</div>
