@model List<waranon_csi402.Models.Cartitem>
@{
    Layout = "_Layout2";
    ViewData["Title"] = "ชำระเงินและสั่งซื้อสินค้า";

    decimal subtotal = ViewBag.Subtotal ?? 0;
    decimal discountAmt = ViewBag.DiscountAmt ?? 0;
    string discountDesc = ViewBag.DiscountDesc ?? "";
    decimal shippingFee = ViewBag.ShippingFee ?? 0;
    decimal grandTotal = ViewBag.GrandTotal ?? 0;
    string? couponCode = ViewBag.CouponCode;
    var addresses = ViewBag.Addresses as List<waranon_csi402.Models.Address> ?? new List<waranon_csi402.Models.Address>();
}

<div class="container py-4">
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">หน้าหลัก</a></li>
                <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index">ตะกร้าสินค้า</a></li>
                <li class="breadcrumb-item active" aria-current="page">ชำระเงิน</li>
            </ol>
        </nav>
        <h3 class="fw-bold mb-0">
            <i class="fa-solid fa-credit-card text-primary me-2"></i>ชำระเงินและสั่งซื้อสินค้า
        </h3>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="post" asp-action="PlaceOrder" id="checkoutForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="couponCode" value="@couponCode" />

        <div class="row g-4">
            <!-- คอลัมน์ซ้าย: ข้อมูลจัดส่ง & ช่องทางชำระเงิน -->
            <div class="col-lg-8">
                <!-- 1. ที่อยู่จัดส่ง -->
                <div class="card shadow-sm border-0 rounded-4 mb-4 overflow-hidden">
                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                        <i class="fa-solid fa-location-dot text-danger fs-5 me-2"></i>
                        <h5 class="fw-bold mb-0">1. ที่อยู่สำหรับจัดส่งสินค้า</h5>
                    </div>
                    <div class="card-body p-4">
                        @if (addresses.Any())
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted small">เลือกที่อยู่ที่บันทึกไว้:</label>
                                @foreach (var addr in addresses)
                                {
                                    <div class="form-check border rounded-3 p-3 mb-2 address-card" style="cursor: pointer;">
                                        <input class="form-check-input ms-0 me-3" type="radio" name="selectedAddressId" 
                                               id="addr_@addr.AddressId" value="@addr.AddressId" 
                                               @(addr.IsDefault || addr == addresses.First() ? "checked" : "")
                                               onchange="toggleNewAddressForm(false)" />
                                        <label class="form-check-label w-100" for="addr_@addr.AddressId">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fw-bold text-dark">@addr.ReceiverName</span>
                                                <span class="text-muted small"><i class="fa-solid fa-phone me-1"></i>@addr.Phone</span>
                                            </div>
                                            <div class="text-muted small">
                                                @addr.AddressLine, @addr.District, @addr.Province @addr.PostalCode
                                            </div>
                                        </label>
                                    </div>
                                }

                                <div class="form-check border rounded-3 p-3 mb-2" style="cursor: pointer;">
                                    <input class="form-check-input ms-0 me-3" type="radio" name="selectedAddressId" 
                                           id="addr_new" value="0" onchange="toggleNewAddressForm(true)" />
                                    <label class="form-check-label fw-semibold text-primary" for="addr_new">
                                        <i class="fa-solid fa-plus-circle me-1"></i>ใช้ที่อยู่จัดส่งใหม่
                                    </label>
                                </div>
                            </div>
                        }

                        <!-- ฟอร์มกรอกที่อยู่ใหม่ -->
                        <div id="newAddressSection" style="@(addresses.Any() ? "display: none;" : "")" class="p-3 bg-light rounded-3 mt-3">
                            <h6 class="fw-bold mb-3 text-secondary">กรอกรายละเอียดที่อยู่ใหม่:</h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">ชื่อ-นามสกุล ผู้รับ <span class="text-danger">*</span></label>
                                    <input type="text" name="newReceiverName" class="form-control" placeholder="เช่น นายสมชาย ใจดี" 
                                           value="@(TempData.Peek("Name") ?? "")" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">เบอร์โทรศัพท์ติดต่อ <span class="text-danger">*</span></label>
                                    <input type="tel" name="newPhone" class="form-control" placeholder="เช่น 0812345678" 
                                           value="@(TempData.Peek("PhoneNumber") ?? "")" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-semibold">ที่อยู่ / บ้านเลขที่ / ถนน / ซอย <span class="text-danger">*</span></label>
                                    <textarea name="newAddressLine" rows="2" class="form-control" placeholder="เช่น 123/45 ซอยสุขุมวิท 55 ถนนสุขุมวิท"></textarea>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">เขต / อำเภอ</label>
                                    <input type="text" name="newDistrict" class="form-control" placeholder="เช่น วัฒนา" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">จังหวัด</label>
                                    <input type="text" name="newProvince" class="form-control" value="กรุงเทพมหานคร" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">รหัสไปรษณีย์</label>
                                    <input type="text" name="newPostalCode" class="form-control" placeholder="เช่น 10110" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. วิธีการชำระเงิน -->
                <div class="card shadow-sm border-0 rounded-4 mb-4 overflow-hidden">
                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                        <i class="fa-solid fa-wallet text-success fs-5 me-2"></i>
                        <h5 class="fw-bold mb-0">2. ช่องทางการชำระเงิน</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="form-check border rounded-3 p-3 mb-3 bg-light">
                            <input class="form-check-input ms-0 me-3" type="radio" name="paymentMethod" 
                                   id="pay_promptpay" value="PromptPay" checked />
                            <label class="form-check-label w-100" for="pay_promptpay">
                                <div class="d-flex align-items-center mb-1">
                                    <i class="fa-solid fa-qrcode text-primary fs-4 me-2"></i>
                                    <span class="fw-bold">โอนเงินผ่าน PromptPay QR Code</span>
                                    <span class="badge bg-success ms-2">แนะนำ</span>
                                </div>
                                <small class="text-muted d-block">
                                    สั่งซื้อแล้วสแกนชำระเงิน พร้อมแนบสลิปหลักฐานเพื่อตรวจสอบได้ทันที
                                </small>
                            </label>
                        </div>

                        <div class="form-check border rounded-3 p-3 mb-3">
                            <input class="form-check-input ms-0 me-3" type="radio" name="paymentMethod" 
                                   id="pay_bank" value="Bank Transfer" />
                            <label class="form-check-label w-100" for="pay_bank">
                                <div class="d-flex align-items-center mb-1">
                                    <i class="fa-solid fa-building-columns text-info fs-4 me-2"></i>
                                    <span class="fw-bold">โอนเงินผ่านบัญชีธนาคาร (Bank Transfer)</span>
                                </div>
                                <small class="text-muted d-block">
                                    โอนผ่าน Mobile Banking หรือตู้ ATM บัญชีกสิกรไทย 012-3-45678-9
                                </small>
                            </label>
                        </div>

                        <div class="form-check border rounded-3 p-3">
                            <input class="form-check-input ms-0 me-3" type="radio" name="paymentMethod" 
                                   id="pay_credit" value="Credit Card" />
                            <label class="form-check-label w-100" for="pay_credit">
                                <div class="d-flex align-items-center mb-1">
                                    <i class="fa-solid fa-credit-card text-secondary fs-4 me-2"></i>
                                    <span class="fw-bold">บัตรเครดิต / บัตรเดบิต (Credit Card)</span>
                                </div>
                                <small class="text-muted d-block">
                                    ชำระผ่าน Visa, Mastercard, JCB
                                </small>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- 3. รายการสินค้าที่สั่งซื้อ -->
                <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="fw-bold mb-0">
                            <i class="fa-solid fa-boxes-stacked text-secondary me-2"></i>3. รายการสินค้า (@Model.Sum(i => i.Quantity) ชิ้น)
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        @foreach (var item in Model)
                        {
                            var unitPrice = item.Variant.Product.BasePrice + item.Variant.ExtraPrice;
                            var lineTotal = unitPrice * item.Quantity;

                            <div class="p-3 border-bottom d-flex align-items-center">
                                <img src="@(string.IsNullOrEmpty(item.Variant.Product.ImageUrl) ? "https://placehold.co/70x85?text=Clothes" : item.Variant.Product.ImageUrl)" 
                                     alt="@item.Variant.Product.ProductName" 
                                     class="rounded-3 me-3 object-fit-cover shadow-sm"
                                     style="width: 55px; height: 65px;" />
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold mb-0 text-dark">@item.Variant.Product.ProductName</h6>
                                    <div class="small text-muted">
                                        สี: @item.Variant.Color | ไซส์: @item.Variant.Size | @item.Quantity ชิ้น
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold text-dark">฿@lineTotal.ToString("N0")</span>
                                    <small class="d-block text-muted">(฿@unitPrice.ToString("N0")/ชิ้น)</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- คอลัมน์ขวา: สรุปยอดเงินและปุ่มสั่งซื้อ -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 rounded-4 p-4 sticky-top" style="top: 20px;">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">สรุปยอดชำระ</h5>

                    <!-- โค้ดส่วนลดในหน้า Checkout -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">โค้ดคูปองส่วนลด:</label>
                        <div class="input-group input-group-sm">
                            <input type="text" id="chkCouponInput" class="form-control text-uppercase" 
                                   placeholder="เช่น NEW50, SAVE10" value="@couponCode" />
                            <button type="button" class="btn btn-outline-primary" onclick="applyCheckoutCoupon()">ใช้โค้ด</button>
                        </div>
                        @if (!string.IsNullOrEmpty(ViewBag.CouponMsg as string))
                        {
                            bool isValid = ViewBag.IsCouponValid == true;
                            <div class="mt-1 small @(isValid ? "text-success fw-semibold" : "text-danger")">
                                <i class="fa-solid @(isValid ? "fa-circle-check" : "fa-circle-exclamation") me-1"></i>@ViewBag.CouponMsg
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">ยอดรวมสินค้า:</span>
                        <span class="fw-semibold">฿@subtotal.ToString("N0")</span>
                    </div>

                    @if (discountAmt > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>
                                <i class="fa-solid fa-tag me-1"></i>ส่วนลดโปรโมชั่น:
                                <small class="d-block text-muted" style="font-size: 0.75rem;">@discountDesc</small>
                            </span>
                            <span class="fw-bold">-฿@discountAmt.ToString("N0")</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">ค่าจัดส่งพัสดุ:</span>
                        <span>
                            @if (shippingFee == 0)
                            {
                                <span class="badge bg-success-subtle text-success">ส่งฟรี</span>
                            }
                            else
                            {
                                <span class="fw-semibold">฿@shippingFee.ToString("N0")</span>
                            }
                        </span>
                    </div>

                    <hr class="my-3" />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <span class="fs-5 fw-bold">ยอดชำระสุทธิ:</span>
                            <small class="d-block text-muted">รวมภาษีและค่าจัดส่งแล้ว</small>
                        </div>
                        <span class="fs-3 fw-bolder text-primary">฿@grandTotal.ToString("N0")</span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg rounded-pill w-100 fw-bold shadow mb-3 py-3">
                        <i class="fa-solid fa-lock me-2"></i>ยืนยันการสั่งซื้อ
                    </button>

                    <div class="text-center text-muted small">
                        <i class="fa-solid fa-shield-halved text-success me-1"></i>ระบบตัดสต็อกสินค้าและบันทึกออเดอร์ทันที
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function toggleNewAddressForm(isNew) {
            var section = document.getElementById("newAddressSection");
            if (section) {
                section.style.display = isNew ? "block" : "none";
            }
        }

        function applyCheckoutCoupon() {
            var code = document.getElementById('chkCouponInput').value;
            window.location.href = '@Url.Action("Checkout", "Cart")?couponCode=' + encodeURIComponent(code);
        }

        document.getElementById('chkCouponInput')?.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                applyCheckoutCoupon();
            }
        });
    </script>
}

