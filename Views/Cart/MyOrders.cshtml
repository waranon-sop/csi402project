@model List<waranon_csi402.Models.Order>
@{
    Layout = "_Layout2";
    ViewData["Title"] = "ประวัติการสั่งซื้อ";

    string GetStatusBadge(string status) => status switch
    {
        "Pending Payment"  => "warning",
        "Verifying Slip"   => "info",
        "Paid"             => "primary",
        "Processing"       => "secondary",
        "Shipped"          => "success",
        "Completed"        => "dark",
        "Cancelled"        => "danger",
        _                  => "light"
    };
}

<div class="d-flex align-items-center mb-4">
    <h3 class="fw-bold mb-0 me-auto">
        <i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>ประวัติการสั่งซื้อ
    </h3>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
        <i class="fa-solid fa-arrow-left me-1"></i>ช้อปปิ้งต่อ
    </a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="text-center py-5 my-4">
        <div class="mb-4">
            <i class="fa-solid fa-box-open fa-5x text-muted opacity-50"></i>
        </div>
        <h4 class="fw-semibold text-muted">ยังไม่มีประวัติการสั่งซื้อ</h4>
        <p class="text-secondary mb-4">เริ่มช้อปปิ้งและสร้างความทรงจำดีๆ กับเสื้อผ้าสุดเก๋!</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-5">
            <i class="fa-solid fa-shirt me-2"></i>เริ่มช้อปปิ้ง
        </a>
    </div>
}
else
{
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3 fw-semibold text-muted">#คำสั่งซื้อ</th>
                            <th class="py-3 fw-semibold text-muted">วันที่</th>
                            <th class="py-3 fw-semibold text-muted text-center">รายการ</th>
                            <th class="py-3 fw-semibold text-muted text-end">ยอดรวม</th>
                            <th class="py-3 fw-semibold text-muted text-center">สถานะ</th>
                            <th class="pe-4 py-3 fw-semibold text-muted text-center">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-primary">#@order.OrderId</span>
                                </td>
                                <td>
                                    <div class="text-dark fw-medium">@order.OrderedAt.ToString("dd MMM yyyy")</div>
                                    <small class="text-muted">@order.OrderedAt.ToString("HH:mm น.")</small>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@order.Orderitems.Count รายการ</span>
                                </td>
                                <td class="text-end">
                                    <span class="fw-bold text-dark">฿@order.TotalAmount.ToString("N0")</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-@GetStatusBadge(order.Status) px-3 py-2 rounded-pill">
                                        @order.Status
                                    </span>
                                </td>
                                <td class="pe-4 text-center">
                                    <a asp-controller="Cart" asp-action="OrderDetail" asp-route-id="@order.OrderId"
                                       class="btn btn-outline-primary btn-sm rounded-pill me-1">
                                        <i class="fa-solid fa-eye me-1"></i>รายละเอียด
                                    </a>
                                    @if (order.Status == "Pending Payment")
                                    {
                                        <a asp-controller="Cart" asp-action="OrderSuccess" asp-route-orderId="@order.OrderId"
                                           class="btn btn-warning btn-sm rounded-pill">
                                            <i class="fa-solid fa-paperclip me-1"></i>แนบสลิป
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
