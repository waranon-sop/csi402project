@model waranon_csi402.Models.Product

@{
    ViewData["Title"] = Model.ProductName + " - เสื้อผ้า.com";
    var related = ViewBag.RelatedProducts as List<waranon_csi402.Models.Product> ?? new List<waranon_csi402.Models.Product>();
    var variants = Model.Productvariants?.ToList() ?? new List<waranon_csi402.Models.Productvariant>();
    int totalStock = variants.Sum(v => v.Stock);
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="my-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">หน้าแรก</a></li>
        <li class="breadcrumb-item">
            <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="text-decoration-none">
                @(Model.Category?.CategoryName ?? "หมวดหมู่")
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">@Model.ProductName</li>
    </ol>
</nav>

<div class="card shadow-sm border-0 mb-5">
    <div class="card-body p-4">
        <div class="row g-4">
            <!-- ฝั่งซ้าย: รูปภาพสินค้า -->
            <div class="col-md-5">
                <div class="bg-light rounded-3 text-center overflow-hidden border p-2" style="min-height: 380px;">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img id="mainProductImage" src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.ProductName"
                             style="max-height: 450px; width: 100%; object-fit: contain;"
                             onerror="this.style.display='none'; document.getElementById('noImageFallback').classList.remove('d-none');" />
                        <div id="noImageFallback" class="d-none flex-column align-items-center justify-content-center h-100 py-5 text-muted">
                            <i class="fa-solid fa-shirt fa-5x mb-3 text-secondary opacity-50"></i>
                            <p class="mb-0 text-muted">เสื้อผ้า.com - รออัปเดตรูปภาพ</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center h-100 py-5 text-muted">
                            <i class="fa-solid fa-shirt fa-5x mb-3 text-secondary opacity-50"></i>
                            <p class="mb-0 text-muted">เสื้อผ้า.com - รออัปเดตรูปภาพ</p>
                        </div>
                    }
                </div>
            </div>

            <!-- ฝั่งขวา: รายละเอียดและการเลือกซื้อ -->
            <div class="col-md-7">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="badge bg-secondary mb-2">@(Model.Category?.CategoryName ?? "สินค้าแฟชั่น")</span>
                    <form method="post" asp-action="ToggleWishlist" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" class="btn @(ViewBag.IsWishlisted == true ? "btn-danger" : "btn-outline-danger") btn-sm rounded-pill" title="บันทึกในรายการโปรด">
                            <i class="@(ViewBag.IsWishlisted == true ? "fa-solid" : "fa-regular") fa-heart me-1"></i>
                            @(ViewBag.IsWishlisted == true ? "ถูกใจแล้ว" : "ถูกใจ")
                        </button>
                    </form>
                </div>

                <h3 class="fw-bold mb-1">@Model.ProductName</h3>

                <!-- คะแนนรีวิว -->
                <div class="d-flex align-items-center mb-3 gap-2">
                    <div class="text-warning small">
                        @for (int s = 1; s <= 5; s++)
                        {
                            if (s <= Math.Round((double)(ViewBag.AverageRating ?? 5.0)))
                            {
                                <i class="fa-solid fa-star"></i>
                            }
                            else
                            {
                                <i class="fa-regular fa-star"></i>
                            }
                        }
                    </div>
                    <span class="small fw-bold text-dark">@(((double)(ViewBag.AverageRating ?? 5.0)).ToString("0.0"))</span>
                    <span class="small text-muted">(@(ViewBag.TotalReviews ?? 0) รีวิว)</span>
                </div>

                <!-- ราคา -->
                <div class="p-3 bg-light rounded-3 mb-3 d-flex align-items-baseline gap-2">
                    <span class="text-muted small">ราคา:</span>
                    <span class="fs-2 fw-bold text-danger" id="displayPrice">฿@Model.BasePrice.ToString("N2")</span>
                    <small class="text-muted">(รวมภาษีมูลค่าเพิ่มแล้ว)</small>
                </div>

                <!-- คำอธิบายสินค้า -->
                <div class="mb-4">
                    <h6 class="fw-bold text-dark mb-1">รายละเอียดสินค้า:</h6>
                    <p class="text-muted mb-0" style="white-space: pre-line;">
                        @(string.IsNullOrEmpty(Model.Description) ? "ไม่มีรายละเอียดเพิ่มเติมสำหรับสินค้านี้" : Model.Description)
                    </p>
                </div>

                <hr />

                <!-- ตัวเลือกสินค้า SKU (Color, Size, Stock) -->
                @if (variants.Any())
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="fw-bold form-label mb-0">เลือกตัวเลือกสินค้า (สี / ไซส์):</label>
                            <!-- ปุ่มเปิดตารางไซส์ -->
                            <button type="button" class="btn btn-link btn-sm text-decoration-none p-0 text-primary" data-bs-toggle="modal" data-bs-target="#sizeGuideModal">
                                <i class="fa-solid fa-ruler-horizontal me-1"></i>ตารางเทียบไซส์ (Size Guide)
                            </button>
                        </div>

                        <!-- Dropdown หรือ Radio ตัวเลือก Variant -->
                        <select id="variantSelect" class="form-select form-select-lg mb-2" onchange="updateVariantSelection()">
                            @foreach (var v in variants)
                            {
                                var finalPrice = Model.BasePrice + v.ExtraPrice;
                                <option value="@v.VariantId" 
                                        data-price="@finalPrice" 
                                        data-stock="@v.Stock" 
                                        data-image="@v.ImageUrl"
                                        data-extra="@v.ExtraPrice">
                                    สี: @v.Color | ไซส์: @v.Size 
                                    @(v.ExtraPrice > 0 ? $"(+฿{v.ExtraPrice:N2})" : "") 
                                    - คงเหลือ @v.Stock ชิ้น
                                </option>
                            }
                        </select>

                        <!-- แสดงสถานะสต็อก -->
                        <div id="stockBadgeContainer" class="mt-2">
                            <span class="badge bg-success" id="stockStatus">
                                <i class="fa-solid fa-circle-check me-1"></i>มีสินค้าพร้อมส่ง
                            </span>
                            <span class="text-muted small ms-2" id="stockAmount"></span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning py-2 small mb-3">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>สินค้านี้ยังไม่มีการระบุตัวเลือกสี/ไซส์
                    </div>
                }

                <!-- จำนวนและปุ่มสั่งซื้อ -->
                <form method="post" asp-controller="Cart" asp-action="AddToCart" class="mt-4">
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <input type="hidden" name="variantId" id="selectedVariantId" value="@(variants.FirstOrDefault()?.VariantId ?? 0)" />

                    <div class="row g-2 align-items-center mb-3">
                        <div class="col-4 col-sm-3">
                            <label class="form-label small fw-semibold">จำนวน:</label>
                            <input type="number" id="buyQuantity" name="quantity" class="form-control text-center" value="1" min="1" max="99" />
                        </div>
                        <div class="col-8 col-sm-9">
                            <label class="form-label small fw-semibold d-none d-sm-block">&nbsp;</label>
                            <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold shadow-sm" id="addToCartBtn">
                                <i class="fa-solid fa-cart-plus me-2"></i>เพิ่มลงตะกร้า
                            </button>
                        </div>
                    </div>
                </form>

                <!-- จุดเด่นร้านค้า -->
                <div class="row g-2 pt-3 border-top text-center text-muted small">
                    <div class="col-4">
                        <i class="fa-solid fa-shield-halved text-success d-block fs-5 mb-1"></i>
                        <span>ของแท้ 100%</span>
                    </div>
                    <div class="col-4">
                        <i class="fa-solid fa-arrow-rotate-left text-primary d-block fs-5 mb-1"></i>
                        <span>คืนได้ใน 7 วัน</span>
                    </div>
                    <div class="col-4">
                        <i class="fa-solid fa-truck-fast text-warning d-block fs-5 mb-1"></i>
                        <span>จัดส่งไวทั่วไทย</span>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- ตารางเทียบไซส์ Modal (Size Guide) ตาม Requirements ข้อ 2 -->
<div class="modal fade" id="sizeGuideModal" tabindex="-1" aria-labelledby="sizeGuideModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="sizeGuideModalLabel">
                    <i class="fa-solid fa-ruler-combined text-primary me-2"></i>ตารางเทียบขนาดเสื้อผ้า (Size Guide)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">หน่วยวัดขนาดเป็น <strong>นิ้ว (Inches)</strong> เพื่อความแม่นยำในการเลือกขนาดที่เหมาะสมกับคุณ:</p>
                <div class="table-responsive">
                    <table class="table table-bordered table-striped text-center align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>ไซส์ (Size)</th>
                                <th>รอบอก (Chest)</th>
                                <th>ความยาวเสื้อ (Length)</th>
                                <th>ไหล่กว้าง (Shoulder)</th>
                                <th>ความยาวแขน (Sleeve)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span class="badge bg-secondary">S</span></td>
                                <td>36" - 38"</td>
                                <td>26"</td>
                                <td>16"</td>
                                <td>8"</td>
                            </tr>
                            <tr>
                                <td><span class="badge bg-secondary">M</span></td>
                                <td>38" - 40"</td>
                                <td>27"</td>
                                <td>17"</td>
                                <td>8.5"</td>
                            </tr>
                            <tr>
                                <td><span class="badge bg-secondary">L</span></td>
                                <td>40" - 42"</td>
                                <td>28"</td>
                                <td>18"</td>
                                <td>9"</td>
                            </tr>
                            <tr>
                                <td><span class="badge bg-secondary">XL</span></td>
                                <td>42" - 44"</td>
                                <td>29"</td>
                                <td>19"</td>
                                <td>9.5"</td>
                            </tr>
                            <tr>
                                <td><span class="badge bg-secondary">2XL</span></td>
                                <td>44" - 48"</td>
                                <td>30"</td>
                                <td>20"</td>
                                <td>10"</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="mt-3 alert alert-info py-2 small mb-0">
                    <i class="fa-solid fa-circle-info me-1"></i>ขนาดอาจคลาดเคลื่อนจากการตัดเย็บประมาณ ±0.5 นิ้ว
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">ปิดหน้าต่าง</button>
            </div>
        </div>
    </div>
</div>

<!-- ส่วนรีวิวและความคิดเห็นจากลูกค้า (Reviews & Ratings) -->
@{
    var reviews = ViewBag.Reviews as List<waranon_csi402.Models.Review> ?? new List<waranon_csi402.Models.Review>();
}
<div class="card shadow-sm border-0 rounded-4 p-4 mt-5 bg-white">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 border-bottom pb-3 gap-2">
        <div>
            <h4 class="fw-bold mb-1">
                <i class="fa-solid fa-star text-warning me-2"></i>รีวิวจากผู้ใช้งานจริง
            </h4>
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4 fw-bold text-dark">@(((double)(ViewBag.AverageRating ?? 5.0)).ToString("0.0"))</span>
                <div class="text-warning small">
                    @for (int st = 1; st <= 5; st++)
                    {
                        if (st <= Math.Round((double)(ViewBag.AverageRating ?? 5.0)))
                        {
                            <i class="fa-solid fa-star"></i>
                        }
                        else
                        {
                            <i class="fa-regular fa-star"></i>
                        }
                    }
                </div>
                <span class="text-muted small">จากทั้งหมด @reviews.Count รีวิว</span>
            </div>
        </div>

        @if (ViewBag.CanReview == true)
        {
            <button class="btn btn-primary rounded-pill btn-sm px-4 fw-semibold" type="button"
                    data-bs-toggle="collapse" data-bs-target="#writeReviewCollapse">
                <i class="fa-solid fa-pen-to-square me-1"></i>เขียนรีวิวสินค้านี้
            </button>
        }
        else
        {
            <span class="text-muted small">
                <i class="fa-solid fa-circle-info me-1"></i>รีวิวได้เมื่อสั่งซื้อและได้รับสินค้านี้แล้ว
            </span>
        }
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.ReviewStatus as string))
    {
        <div class="alert alert-info py-2 small mb-3">@ViewBag.ReviewStatus</div>
    }

    <!-- ฟอร์มเขียนรีวิว (Collapse) -->
    @if (ViewBag.CanReview == true)
    {
    <div class="collapse mb-4" id="writeReviewCollapse">
        <form method="post" asp-action="AddReview" class="p-3 bg-light rounded-4 border">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.ProductId" />
            <h6 class="fw-bold mb-3 text-dark">แบ่งปันความประทับใจของคุณต่อสินค้านี้:</h6>

            <div class="mb-3">
                <label class="form-label small fw-semibold">ให้คะแนนความพึงพอใจ:</label>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="rating" id="r5" value="5" checked />
                        <label class="form-check-label text-warning small" for="r5">⭐⭐⭐⭐⭐ ดีเยี่ยม</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="rating" id="r4" value="4" />
                        <label class="form-check-label text-warning small" for="r4">⭐⭐⭐⭐ ดีมาก</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="rating" id="r3" value="3" />
                        <label class="form-check-label text-warning small" for="r3">⭐⭐⭐ ปานกลาง</label>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">ความคิดเห็น / ความประทับใจในเนื้อผ้า ขนาด การตัดเย็บ:</label>
                <textarea name="comment" rows="3" class="form-control" placeholder="เนื้อผ้านุ่มใส่สบายมาก ตรงปก ขนาดพอดีตัว..." required></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold">
                <i class="fa-solid fa-paper-plane me-1"></i>ส่งรีวิวสินค้า
            </button>
        </form>
    </div>
    }

    <!-- รายการรีวิว -->
    @if (!reviews.Any())
    {
        <div class="text-center py-4 text-muted">
            <i class="fa-regular fa-comment-dots fa-3x opacity-50 mb-2"></i>
            <p class="mb-0">ยังไม่มีรีวิวสำหรับสินค้านี้ เป็นคนแรกที่ให้คะแนนสินค้านี้ได้เลย!</p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var rev in reviews)
            {
                <div class="p-3 border-bottom">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <div class="d-flex align-items-center gap-2">
                            <span class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle small fw-bold" style="width: 32px; height: 32px;">
                                @((rev.User?.FirstName?.Length > 0 ? rev.User.FirstName.Substring(0, 1) : "U").ToUpper())
                            </span>
                            <strong class="text-dark">@(rev.User != null ? $"{rev.User.FirstName} {rev.User.LastName?.Substring(0, 1)}." : "ผู้ใช้งานเสื้อผ้า.com")</strong>
                        </div>
                        <small class="text-muted">@rev.CreatedAt.ToString("dd MMM yyyy")</small>
                    </div>

                    <div class="text-warning small mb-2 ps-4 ms-2">
                        @for (int r = 1; r <= 5; r++)
                        {
                            if (r <= rev.Rating)
                            {
                                <i class="fa-solid fa-star"></i>
                            }
                            else
                            {
                                <i class="fa-regular fa-star"></i>
                            }
                        }
                    </div>

                    <p class="text-secondary small mb-0 ps-4 ms-2">
                        @rev.Comment
                    </p>
                </div>
            }
        </div>
    }
</div>

<!-- สินค้าที่เกี่ยวข้อง (Related Products) -->
@if (related.Any())
{
    <div class="mt-5">
        <h4 class="fw-bold mb-3">
            <i class="fa-solid fa-thumbs-up text-primary me-2"></i>สินค้าอื่นๆ ในหมวดหมู่เดียวกัน
        </h4>
        <div class="row row-cols-2 row-cols-md-4 g-3">
            @foreach (var item in related)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="bg-light text-center overflow-hidden" style="height: 180px;">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="card-img-top w-100 h-100" style="object-fit: cover;" alt="@item.ProductName"
                                     onerror="this.onerror=null; this.src='https://placehold.co/400x400/e9ecef/495057?text=No+Image';" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                    <i class="fa-solid fa-image fa-2x"></i>
                                </div>
                            }
                        </div>
                        <div class="card-body p-3 d-flex flex-column">
                            <h6 class="card-title fw-bold text-truncate mb-1">
                                <a asp-action="ProductDetail" asp-route-id="@item.ProductId" class="text-decoration-none text-dark">
                                    @item.ProductName
                                </a>
                            </h6>
                            <span class="text-danger fw-bold fs-6 mt-auto">฿@item.BasePrice.ToString("N2")</span>
                            <a asp-action="ProductDetail" asp-route-id="@item.ProductId" class="btn btn-outline-dark btn-sm w-100 mt-2">
                                ดูสินค้า
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        function updateVariantSelection() {
            var select = document.getElementById("variantSelect");
            if (!select) return;

            var selectedOption = select.options[select.selectedIndex];
            var price = parseFloat(selectedOption.getAttribute("data-price"));
            var stock = parseInt(selectedOption.getAttribute("data-stock"));
            var image = selectedOption.getAttribute("data-image");
            var variantId = selectedOption.value;

            // อัปเดตราคาสินค้าตามตัวเลือก
            if (!isNaN(price)) {
                document.getElementById("displayPrice").innerText = "฿" + price.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            // อัปเดตรูปภาพเฉพาะ variant (ถ้ามี)
            if (image && image.trim() !== "") {
                var imgElem = document.getElementById("mainProductImage");
                if (imgElem) {
                    imgElem.src = image;
                }
            }

            // อัปเดต Variant ID ที่ซ่อนไว้สำหรับส่งฟอร์ม
            document.getElementById("selectedVariantId").value = variantId;

            // ตรวจสอบสต็อก
            var stockBadge = document.getElementById("stockStatus");
            var stockAmount = document.getElementById("stockAmount");
            var addToCartBtn = document.getElementById("addToCartBtn");
            var buyQty = document.getElementById("buyQuantity");

            if (stock > 0) {
                stockBadge.className = "badge bg-success";
                stockBadge.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i>มีสินค้าพร้อมส่ง';
                stockAmount.innerText = "(เหลือ " + stock + " ชิ้น)";
                addToCartBtn.disabled = false;
                addToCartBtn.innerHTML = '<i class="fa-solid fa-cart-plus me-2"></i>เพิ่มลงตะกร้า';
                buyQty.max = stock;
            } else {
                stockBadge.className = "badge bg-danger";
                stockBadge.innerHTML = '<i class="fa-solid fa-circle-xmark me-1"></i>สินค้าหมดชั่วคราว';
                stockAmount.innerText = "";
                addToCartBtn.disabled = true;
                addToCartBtn.innerHTML = '<i class="fa-solid fa-ban me-2"></i>สินค้าหมด';
            }
        }

        // เรียกทำงานทันทีเมื่อโหลดหน้าเว็บ
        document.addEventListener("DOMContentLoaded", function () {
            updateVariantSelection();
        });
    </script>
}

