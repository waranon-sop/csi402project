@model IEnumerable<waranon_csi402.Models.Labstudent>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Password</th>
            <th>Name</th>
            <th>Last Name</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var Labstudent in Model)
        {
            <tr>
                <td>@Labstudent.StdId</td>
                <td>@Labstudent.StdPassword</td>
                <td>@Labstudent.StdName</td>
                <td>@Labstudent.StdLastname</td>
                <td><a asp-action="Lab10" asp-controller="Home" asp-route-StdId="@Labstudent.StdId">Edit</a></td>
                <td><a asp-action="Lab10_1" asp-controller="Home" asp-route-StdId="@Labstudent.StdId">Delete</a></td>
            </tr>
        }
    </tbody>
    <p class="text-danger">@ViewBag.Status</p>
</table>