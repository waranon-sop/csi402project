@model waranon_csi402.Models.Labstudent

<form asp-action="Lab9" asp-controller="Home">
    studentID <input type="text" asp-for="StdId" class="form-control" />
    Password <input type="password" asp-for="StdPassword" class="form-control" />
    Name <input type="text" asp-for="StdName" class="form-control" />
    Lastname <input type="text" asp-for="StdLastname" class="form-control" />
    <button type="submit">Submit</button>
</form>

<p class="text-danger">@ViewBag.Status</p>