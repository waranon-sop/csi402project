@model waranon_csi402.Models.Order

@{
    ViewData["Title"] = $"รายละเอียดคำสั่งซื้อ #{Model.OrderId}";
    Layout = "_LayoutStaff";
}

<!-- Alert Status Notification -->
@if (!string.IsNullOrEmpty(ViewBag.Status))
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
        <i class="fa-solid fa-circle-check fs-4 me-3 text-success"></i>
        <div class="flex-grow-1">
            <span class="fw-medium">@ViewBag.Status</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Page Header & Action Controls -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle me-3 p-0 d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px;" title="ย้อนกลับ">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <div>
            <div class="d-flex align-items-center gap-2">
                <h3 class="fw-bold mb-0 text-dark">คำสั่งซื้อ #@Model.OrderId</h3>
                @if (Model.Status == "Paid")
                {
                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill">
                        <i class="fa-solid fa-circle-check me-1"></i>รอเตรียมแพ็ค
                    </span>
                }
                else if (Model.Status == "Processing")
                {
                    <span class="badge bg-info text-dark px-3 py-1 rounded-pill">
                        <i class="fa-solid fa-boxes-packing me-1"></i>กำลังแพ็คสินค้า
                    </span>
                }
                else if (Model.Status == "Shipped")
                {
                    <span class="badge bg-success px-3 py-1 rounded-pill">
                        <i class="fa-solid fa-truck-fast me-1"></i>จัดส่งแล้ว
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary px-3 py-1 rounded-pill">@Model.Status</span>
                }
            </div>
            <p class="text-secondary small mb-0 mt-1">
                สั่งซื้อ: @Model.OrderedAt.ToString("dd/MM/yyyy HH:mm") น. • จัดส่งแบบมาตรฐาน
            </p>
        </div>
    </div>

    <!-- Quick Action Header Buttons -->
    <div class="d-flex gap-2 mt-3 mt-md-0">
        <a asp-action="PrintSlip" asp-route-id="@Model.OrderId" target="_blank"
           class="btn btn-outline-dark rounded-pill px-3 shadow-sm">
            <i class="fa-solid fa-print me-1"></i>พิมพ์ใบจัดส่ง & ปะหน้ากล่อง
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Packing Items Checklist (Picking Slip) -->
    <div class="col-lg-7">
        <div class="card card-custom shadow-sm mb-4">
            <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="fa-solid fa-list-check text-success me-2"></i>รายการสินค้าที่ต้องหยิบแพ็ค
                </h5>
                <span class="badge bg-light text-dark border">
                    รวมทั้งสิ้น @(Model.Orderitems?.Sum(i => i.Quantity) ?? 0) ชิ้น
                </span>
            </div>

            <div class="p-3">
                @if (Model.Orderitems != null && Model.Orderitems.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.Orderitems)
                        {
                            var imgUrl = item.Variant?.ImageUrl ?? item.Variant?.Product?.ImageUrl ?? "https://placehold.co/100x100?text=No+Img";
                            <div class="list-group-item p-3 border rounded-3 mb-2 bg-light">
                                <div class="d-flex align-items-center">
                                    <!-- Checkbox for Packing Staff -->
                                    <div class="form-check me-3">
                                        <input class="form-check-input" type="checkbox" style="cursor: pointer; width: 22px; height: 22px;" id="check_@item.OrderItemId" />
                                    </div>

                                    <!-- Product Thumbnail -->
                                    <img src="@imgUrl" class="rounded border me-3 flex-shrink-0 shadow-sm" style="width: 64px; height: 64px; object-fit: cover;" alt="Product" />

                                    <!-- Details -->
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold mb-1 text-dark">
                                            @(item.Variant?.Product?.ProductName ?? "เสื้อผ้าแฟชั่น")
                                        </h6>
                                        <div class="d-flex flex-wrap gap-2 align-items-center mt-1">
                                            <span class="badge bg-white text-dark border px-2 py-1">
                                                สี: <strong>@(item.Variant?.Color ?? "-")</strong>
                                            </span>
                                            <span class="badge bg-white text-dark border px-2 py-1">
                                                ไซส์: <strong>@(item.Variant?.Size ?? "-")</strong>
                                            </span>
                                            <span class="text-muted small">
                                                SKU #@(item.Variant?.VariantId ?? 0)
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Quantity Badge -->
                                    <div class="text-end ms-3">
                                        <div class="badge bg-warning text-dark fs-5 px-3 py-2 rounded-3 border border-warning shadow-sm">
                                            x @item.Quantity ชิ้น
                                        </div>
                                        <div class="text-muted small mt-1">฿@item.UnitPrice.ToString("N2")/ชิ้น</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="card-footer bg-white border-top p-3 text-secondary small">
                <i class="fa-solid fa-circle-info text-info me-1"></i>
                พนักงานสามารถติ๊กเครื่องหมายถูกที่หน้าสินค้าเพื่อตรวจสอบความถูกต้องก่อนปิดกล่องพัสดุ
            </div>
        </div>
    </div>

    <!-- Right Column: Fulfillment Action & Destination Address -->
    <div class="col-lg-5">
        <!-- Action Card: Status Transitions -->
        <div class="card card-custom shadow-sm mb-4 border-2 @(Model.Status == "Paid" ? "border-warning" : (Model.Status == "Processing" ? "border-info" : "border-success"))">
            <div class="card-header bg-white border-bottom p-3">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="fa-solid fa-boxes-packing text-success me-2"></i>การจัดการพัสดุ
                </h5>
            </div>
            <div class="card-body p-4">
                @if (Model.Status == "Paid")
                {
                    <div class="alert alert-warning border-0 mb-3">
                        <div class="fw-bold mb-1"><i class="fa-solid fa-box-open me-1"></i>พร้อมเริ่มแพ็คสินค้า</div>
                        <small>เมื่อรับรายการและเริ่มเตรียมสินค้า ให้กดปุ่มด้านล่างเพื่อเปลี่ยนสถานะเป็นกำลังแพ็ค</small>
                    </div>

                    <form asp-action="PackOrder" method="post">
                        <input type="hidden" name="orderId" value="@Model.OrderId" />
                        <button type="submit" class="btn btn-warning btn-lg w-100 rounded-pill fw-bold shadow-sm py-2">
                            <i class="fa-solid fa-boxes-packing me-2"></i>เริ่มแพ็คสินค้า
                        </button>
                    </form>
                }
                else if (Model.Status == "Processing")
                {
                    <div class="alert alert-info border-0 mb-3">
                        <div class="fw-bold mb-1"><i class="fa-solid fa-truck-ramp-box me-1"></i>กำลังแพ็ค / พร้อมจัดส่ง</div>
                        <small>เมื่อบรรจุกล่องและมอบให้ขนส่งแล้ว ให้กรอกเลขพัสดุและกดยืนยัน</small>
                    </div>

                    <form asp-action="ShipOrder" method="post">
                        <input type="hidden" name="orderId" value="@Model.OrderId" />

                        <div class="mb-3">
                            <label class="form-label fw-bold small">บริษัทขนส่ง</label>
                            <select name="courier" class="form-select">
                                <option value="Flash Express">Flash Express</option>
                                <option value="Kerry Express">Kerry Express</option>
                                <option value="ไปรษณีย์ไทย EMS">ไปรษณีย์ไทย EMS</option>
                                <option value="J&T Express">J&T Express</option>
                                <option value="SPX Express">SPX Express</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">
                                เลขพัสดุ <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="trackingNumber" class="form-control form-control-lg font-monospace"
                                   placeholder="เช่น TH0123456789" required />
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100 rounded-pill fw-bold shadow-sm py-2" style="background-color: #2d6a4f; border-color: #2d6a4f;">
                            <i class="fa-solid fa-truck-fast me-2"></i>ยืนยันจัดส่งเรียบร้อย
                        </button>
                    </form>
                }
                else if (Model.Status == "Shipped" || Model.Status == "Completed")
                {
                    <div class="p-3 rounded-3 bg-success bg-opacity-10 border border-success text-center">
                        <i class="fa-solid fa-circle-check text-success fs-1 mb-2 d-block"></i>
                        <h5 class="fw-bold text-success mb-1">จัดส่งพัสดุเรียบร้อยแล้ว</h5>
                        <div class="bg-white p-2 rounded border font-monospace fs-5 text-dark mt-2 mb-2">
                            @Model.TrackingNumber
                        </div>
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3"
                                onclick="navigator.clipboard.writeText('@Model.TrackingNumber'); alert('คัดลอกเลขพัสดุแล้ว');">
                            <i class="fa-solid fa-copy me-1"></i>คัดลอกเลขพัสดุ
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- Shipping Address Card -->
        <div class="card card-custom shadow-sm mb-4">
            <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="fa-solid fa-location-dot text-danger me-2"></i>ที่อยู่จัดส่งพัสดุ
                </h5>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill"
                        onclick="copyAddress()" title="คัดลอกที่อยู่">
                    <i class="fa-solid fa-copy"></i>
                </button>
            </div>
            <div class="card-body p-3">
                @if (Model.Address != null)
                {
                    <div id="addressContent">
                        <div class="fw-bold text-dark fs-6 mb-1">@Model.Address.ReceiverName</div>
                        <div class="text-primary fw-semibold small mb-2">
                            <i class="fa-solid fa-phone me-1"></i>@Model.Address.Phone
                        </div>
                        <div class="text-secondary small border-top pt-2" style="line-height: 1.6;">
                            @Model.Address.AddressLine<br />
                            เขต/อำเภอ @Model.Address.District จังหวัด @Model.Address.Province<br />
                            <strong class="text-dark">รหัสไปรษณีย์: @Model.Address.PostalCode</strong>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-secondary small">
                        ผู้รับ: @(Model.User?.FirstName + " " + Model.User?.LastName)<br />
                        เบอร์โทร: @(Model.User?.PhoneNumber ?? "-")
                    </div>
                }
            </div>
        </div>

        <!-- Financial Summary -->
        <div class="card card-custom shadow-sm mb-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between text-secondary small mb-2">
                    <span>ยอดรวมค่าสินค้า</span>
                    <span>฿@Model.Subtotal.ToString("N2")</span>
                </div>
                @if (Model.DiscountAmt > 0)
                {
                    <div class="d-flex justify-content-between text-danger small mb-2">
                        <span>ส่วนลด</span>
                        <span>-฿@Model.DiscountAmt.ToString("N2")</span>
                    </div>
                }
                <div class="d-flex justify-content-between text-secondary small mb-2">
                    <span>ค่าจัดส่ง</span>
                    <span>@(Model.ShippingFee > 0 ? "฿" + Model.ShippingFee.ToString("N2") : "ส่งฟรี")</span>
                </div>
                <div class="d-flex justify-content-between border-top pt-2 mt-2">
                    <strong class="text-dark">ยอดสุทธิ</strong>
                    <strong class="text-success fs-5">฿@Model.TotalAmount.ToString("N2")</strong>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyAddress() {
            var el = document.getElementById('addressContent');
            if (el) {
                navigator.clipboard.writeText(el.innerText);
                alert('คัดลอกที่อยู่จัดส่งแล้ว!');
            }
        }
    </script>
}
