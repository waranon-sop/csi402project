@model List<waranon_csi402.Models.Order>
@{
    ViewData["Title"] = "คิวงานตรวจสอบการเงินและสลิป - Accounting";
    Layout = "_LayoutAccounting";

    string currentTab = ViewBag.CurrentTab ?? "verifying";
    int countVerifying = ViewBag.CountVerifying ?? 0;
    int countPaid = ViewBag.CountPaid ?? 0;
    int countInvalid = ViewBag.CountInvalid ?? 0;
    int countPending = ViewBag.CountPending ?? 0;
    decimal totalRevenue = ViewBag.TotalRevenue ?? 0;
    string search = ViewBag.Search ?? "";

    string GetBadgeColor(string status) => status switch
    {
        "Verifying Slip"  => "warning text-dark",
        "Paid"            => "success",
        "Invalid Slip"    => "danger",
        "Pending Payment" => "secondary",
        "Processing"      => "info text-dark",
        "Shipped"         => "primary",
        "Completed"       => "dark",
        _                 => "light text-dark"
    };
}

<div class="container-fluid p-0">
    <!-- Header & Quick Navigation -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="fa-solid fa-file-invoice-dollar text-info me-2"></i>คิวงานตรวจสอบการเงินและสลิป
            </h3>
            <p class="text-secondary small mb-0">ฝ่ายบัญชี: ตรวจสอบหลักฐานการชำระเงิน ตรวจยอดโอน และอนุมัติคำสั่งซื้อเข้าสู่กระบวนการคลังสินค้า</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="FinancialReport" class="btn btn-outline-info btn-sm rounded-pill px-3 shadow-sm">
                <i class="fa-solid fa-chart-pie me-1"></i>รายงานสรุปรายรับ
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3" target="_blank">
                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>ดูหน้าร้าน
            </a>
        </div>
    </div>

    @if (ViewBag.Status != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4 d-flex align-items-center" role="alert">
            <div class="bg-success text-white rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                <i class="fa-solid fa-check"></i>
            </div>
            <div class="flex-grow-1">
                <span class="fw-medium">@ViewBag.Status</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 4 Stat Cards สรุปยอดการเงิน -->
    <div class="row g-3 mb-4">
        <!-- 1. รอตรวจสลิป (Actionable - สำคัญที่สุด) -->
        <div class="col-sm-6 col-xl-3">
            <a asp-action="Index" asp-route-tab="verifying" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 p-3 stat-card-acc @(currentTab == "verifying" ? "border-start border-warning border-4" : "") bg-white h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-semibold d-block mb-1">รอตรวจสอบสลิป</span>
                            <h3 class="fw-bold text-warning mb-0">@countVerifying</h3>
                        </div>
                        <div class="bg-warning-subtle text-warning p-3 rounded-4">
                            <i class="fa-solid fa-receipt fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-2 pt-2 border-top border-light d-flex justify-content-between align-items-center">
                        <small class="text-warning fw-medium" style="font-size: 0.75rem;">
                            <i class="fa-solid fa-clock me-1"></i>ต้องดำเนินการ
                        </small>
                        <i class="fa-solid fa-chevron-right text-muted small"></i>
                    </div>
                </div>
            </a>
        </div>

        <!-- 2. อนุมัติแล้ว (Paid) -->
        <div class="col-sm-6 col-xl-3">
            <a asp-action="Index" asp-route-tab="paid" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 p-3 stat-card-acc @(currentTab == "paid" ? "border-start border-success border-4" : "") bg-white h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-semibold d-block mb-1">อนุมัติแล้ว (Paid)</span>
                            <h3 class="fw-bold text-success mb-0">@countPaid</h3>
                        </div>
                        <div class="bg-success-subtle text-success p-3 rounded-4">
                            <i class="fa-solid fa-circle-check fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-2 pt-2 border-top border-light d-flex justify-content-between align-items-center">
                        <small class="text-success fw-medium" style="font-size: 0.75rem;">
                            <i class="fa-solid fa-boxes-packing me-1"></i>ส่งเข้าคลังสินค้าแล้ว
                        </small>
                        <i class="fa-solid fa-chevron-right text-muted small"></i>
                    </div>
                </div>
            </a>
        </div>

        <!-- 3. สลิปไม่ถูกต้อง (Invalid Slip) -->
        <div class="col-sm-6 col-xl-3">
            <a asp-action="Index" asp-route-tab="invalid" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 p-3 stat-card-acc @(currentTab == "invalid" ? "border-start border-danger border-4" : "") bg-white h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-semibold d-block mb-1">สลิปไม่ถูกต้อง</span>
                            <h3 class="fw-bold text-danger mb-0">@countInvalid</h3>
                        </div>
                        <div class="bg-danger-subtle text-danger p-3 rounded-4">
                            <i class="fa-solid fa-triangle-exclamation fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-2 pt-2 border-top border-light d-flex justify-content-between align-items-center">
                        <small class="text-danger fw-medium" style="font-size: 0.75rem;">
                            <i class="fa-solid fa-rotate-left me-1"></i>รอลูกค้าแนบใหม่
                        </small>
                        <i class="fa-solid fa-chevron-right text-muted small"></i>
                    </div>
                </div>
            </a>
        </div>

        <!-- 4. รายรับรวมสะสม -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 stat-card-acc bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold d-block mb-1">รายรับที่อนุมัติแล้ว</span>
                        <h4 class="fw-bold text-dark mb-0">฿@totalRevenue.ToString("N0")</h4>
                    </div>
                    <div class="bg-info-subtle text-info p-3 rounded-4">
                        <i class="fa-solid fa-wallet fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 pt-2 border-top border-light d-flex justify-content-between align-items-center">
                    <small class="text-muted" style="font-size: 0.75rem;">
                        <i class="fa-solid fa-building-columns me-1"></i>ยอดเงินเข้าบัญชีจริง
                    </small>
                    <a asp-action="FinancialReport" class="text-info small text-decoration-none fw-semibold">ดูรายงาน</a>
                </div>
            </div>
        </div>
    </div>

    <!-- ส่วนตารางรายการ & ตัวกรอง -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white mb-4">
        <!-- แถบ Tabs & Search Box -->
        <div class="card-header bg-white p-3 border-bottom">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <!-- Navigation Tabs -->
                <ul class="nav nav-pills gap-1">
                    <li class="nav-item">
                        <a asp-action="Index" asp-route-tab="verifying" asp-route-search="@search"
                           class="nav-link rounded-pill px-3 py-2 small fw-semibold @(currentTab == "verifying" ? "active bg-warning text-dark shadow-sm" : "text-secondary")">
                            <i class="fa-solid fa-clock-rotate-left me-1"></i>รอตรวจสลิป
                            <span class="badge @(currentTab == "verifying" ? "bg-dark text-white" : "bg-warning text-dark") rounded-pill ms-1">@countVerifying</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Index" asp-route-tab="paid" asp-route-search="@search"
                           class="nav-link rounded-pill px-3 py-2 small fw-semibold @(currentTab == "paid" ? "active bg-success text-white shadow-sm" : "text-secondary")">
                            <i class="fa-solid fa-check me-1"></i>อนุมัติแล้ว
                            <span class="badge @(currentTab == "paid" ? "bg-white text-success" : "bg-light text-dark") rounded-pill ms-1">@countPaid</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Index" asp-route-tab="invalid" asp-route-search="@search"
                           class="nav-link rounded-pill px-3 py-2 small fw-semibold @(currentTab == "invalid" ? "active bg-danger text-white shadow-sm" : "text-secondary")">
                            <i class="fa-solid fa-ban me-1"></i>สลิปไม่ถูกต้อง
                            <span class="badge @(currentTab == "invalid" ? "bg-white text-danger" : "bg-light text-dark") rounded-pill ms-1">@countInvalid</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Index" asp-route-tab="pending" asp-route-search="@search"
                           class="nav-link rounded-pill px-3 py-2 small fw-semibold @(currentTab == "pending" ? "active bg-secondary text-white shadow-sm" : "text-secondary")">
                            <i class="fa-regular fa-hourglass-half me-1"></i>ยังไม่แนบสลิป
                            <span class="badge @(currentTab == "pending" ? "bg-white text-secondary" : "bg-light text-dark") rounded-pill ms-1">@countPending</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Index" asp-route-tab="refunded" asp-route-search="@search"
                           class="nav-link rounded-pill px-3 py-2 small fw-semibold @(currentTab == "refunded" ? "active bg-danger text-white shadow-sm" : "text-secondary")">
                            <i class="fa-solid fa-rotate-left me-1"></i>คืนเงินแล้ว
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Index" asp-route-tab="all" asp-route-search="@search"
                           class="nav-link rounded-pill px-3 py-2 small fw-semibold @(currentTab == "all" ? "active bg-dark text-white shadow-sm" : "text-secondary")">
                            ทั้งหมด
                        </a>
                    </li>
                </ul>

                <!-- Search Form -->
                <form method="get" asp-action="Index" class="d-flex" style="min-width: 280px; max-width: 360px;">
                    <input type="hidden" name="tab" value="@currentTab" />
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" name="search" value="@search" class="form-control bg-light border-start-0 ps-0" placeholder="ค้นหา #ออเดอร์, ลูกค้า, เบอร์..." />
                        @if (!string.IsNullOrEmpty(search))
                        {
                            <a asp-action="Index" asp-route-tab="@currentTab" class="btn btn-light border" title="ล้างการค้นหา">
                                <i class="fa-solid fa-xmark text-muted"></i>
                            </a>
                        }
                        <button type="submit" class="btn btn-dark">ค้นหา</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Order Table -->
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center p-4 mb-3" style="width: 80px; height: 80px;">
                        <i class="fa-solid fa-receipt fa-2x text-muted opacity-50"></i>
                    </div>
                    <h5 class="fw-bold text-dark">ไม่มีรายการคำสั่งซื้อในหมวดนี้</h5>
                    <p class="text-secondary small mb-0">ไม่มีข้อมูลที่ตรงกับเงื่อนไขตัวกรองในขณะนี้</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-muted text-uppercase">
                            <tr>
                                <th class="ps-4 py-3">#ออเดอร์</th>
                                <th class="py-3">ลูกค้า / ข้อมูลติดต่อ</th>
                                <th class="py-3">วันที่สั่งซื้อ</th>
                                <th class="py-3 text-end">ยอดเงินที่ต้องโอน</th>
                                <th class="py-3 text-center">หลักฐานสลิป</th>
                                <th class="py-3 text-center">สถานะ</th>
                                <th class="pe-4 py-3 text-center">การดำเนินการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model)
                            {
                                <tr>
                                    <!-- Order ID -->
                                    <td class="ps-4">
                                        <a asp-action="VerifySlip" asp-route-id="@o.OrderId" class="fw-bold text-primary text-decoration-none fs-6">
                                            #@o.OrderId
                                        </a>
                                        <div class="small text-muted">
                                            <i class="fa-solid fa-box-archive me-1"></i>@o.Orderitems.Count รายการสินค้า
                                        </div>
                                    </td>

                                    <!-- Customer Info -->
                                    <td>
                                        <div class="fw-semibold text-dark">
                                            @(o.Address?.ReceiverName ?? $"{o.User?.FirstName} {o.User?.LastName}")
                                        </div>
                                        <small class="text-muted d-block">
                                            <i class="fa-solid fa-phone me-1 text-secondary"></i>@(o.Address?.Phone ?? o.User?.PhoneNumber ?? "-")
                                        </small>
                                    </td>

                                    <!-- Date -->
                                    <td>
                                        <div class="text-dark small fw-medium">@o.OrderedAt.ToString("dd MMM yyyy")</div>
                                        <small class="text-muted">@o.OrderedAt.ToString("HH:mm น.")</small>
                                    </td>

                                    <!-- Amount -->
                                    <td class="text-end">
                                        <div class="fs-6 fw-bold text-dark">฿@o.TotalAmount.ToString("N0")</div>
                                        <span class="badge bg-light text-muted border" style="font-size: 0.7rem;">@o.PaymentMethod</span>
                                    </td>

                                    <!-- Slip Thumbnail & Preview Button -->
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(o.SlipImageUrl))
                                        {
                                            <div class="position-relative d-inline-block">
                                                <img src="@o.SlipImageUrl" alt="Slip" 
                                                     class="rounded-3 border shadow-sm object-fit-cover slip-thumb-zoom" 
                                                     style="width: 52px; height: 64px;" 
                                                     data-bs-toggle="modal" 
                                                     data-bs-target="#slipModal"
                                                     data-slip-url="@o.SlipImageUrl"
                                                     data-order-id="@o.OrderId"
                                                     data-order-total="฿@o.TotalAmount.ToString("N0")"
                                                     data-customer-name="@(o.Address?.ReceiverName ?? $"{o.User?.FirstName} {o.User?.LastName}")"
                                                     onclick="previewSlip(this)"
                                                     title="คลิกเพื่อดูสลิปภาพใหญ่" />
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border small px-2 py-1">
                                                <i class="fa-regular fa-image me-1"></i>ยังไม่แนบ
                                            </span>
                                        }
                                    </td>

                                    <!-- Status -->
                                    <td class="text-center">
                                        <span class="badge bg-@GetBadgeColor(o.Status) rounded-pill px-3 py-2 small fw-semibold">
                                            @o.Status
                                        </span>
                                    </td>

                                    <!-- Actions -->
                                    <td class="pe-4 text-center">
                                        <div class="d-flex justify-content-center align-items-center gap-1">
                                            <!-- ปุ่มตรวจสลิปอย่างละเอียด -->
                                            <a asp-action="VerifySlip" asp-route-id="@o.OrderId" 
                                               class="btn btn-outline-primary btn-sm rounded-pill px-3" title="ตรวจสอบรายละเอียดและหลักฐาน">
                                                <i class="fa-solid fa-magnifying-glass-dollar me-1"></i>ตรวจสลิป
                                            </a>

                                            @if (o.Status == "Verifying Slip")
                                            {
                                                <!-- Quick Approve Form -->
                                                <form method="post" asp-action="ApproveSlip" class="d-inline"
                                                      onsubmit="return confirm('ยืนยันอนุมัติยอดเงิน ฿@o.TotalAmount.ToString("N0") สำหรับคำสั่งซื้อ #@o.OrderId ?\n\nเมื่ออนุมัติแล้ว ออเดอร์จะส่งต่อไปยังคลังสินค้าเพื่อแพ็คทันที');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="orderId" value="@o.OrderId" />
                                                    <button type="submit" class="btn btn-success btn-sm rounded-circle p-0 d-inline-flex align-items-center justify-content-center" 
                                                            style="width: 31px; height: 31px;" title="อนุมัติการชำระเงิน">
                                                        <i class="fa-solid fa-check"></i>
                                                    </button>
                                                </form>

                                                <!-- Quick Reject Button trigger modal -->
                                                <button type="button" class="btn btn-outline-danger btn-sm rounded-circle p-0 d-inline-flex align-items-center justify-content-center" 
                                                        style="width: 31px; height: 31px;" 
                                                        title="ปฏิเสธสลิป"
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#rejectModal"
                                                        data-order-id="@o.OrderId"
                                                        data-order-total="฿@o.TotalAmount.ToString("N0")"
                                                        onclick="prepareRejectModal(this)">
                                                    <i class="fa-solid fa-xmark"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal 1: Quick Slip Preview Modal -->
<div class="modal fade" id="slipModal" tabindex="-1" aria-labelledby="slipModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom py-3">
                <div>
                    <h5 class="modal-title fw-bold text-dark" id="slipModalLabel">
                        <i class="fa-solid fa-receipt text-warning me-2"></i>หลักฐานการโอนเงิน คำสั่งซื้อ <span id="modalOrderId" class="text-primary"></span>
                    </h5>
                    <small class="text-muted">
                        ลูกค้า: <span id="modalCustomerName" class="fw-semibold text-dark"></span> | ยอดเงินที่ต้องได้รับ: <span id="modalOrderTotal" class="fw-bold text-success"></span>
                    </small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-4 bg-light">
                <div class="bg-white p-2 rounded-4 shadow-sm d-inline-block" style="max-width: 100%;">
                    <img id="modalSlipImg" src="" alt="สลิปโอนเงิน" class="img-fluid rounded-3" style="max-height: 550px; object-fit: contain;" />
                </div>
            </div>
            <div class="modal-footer bg-white border-top d-flex justify-content-between">
                <a id="modalFullLink" href="" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill">
                    <i class="fa-solid fa-up-right-and-down-left-from-center me-1"></i>เปิดในแท็บใหม่
                </a>
                <div>
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">ปิดหน้าต่าง</button>
                    <a id="modalVerifyDetailLink" href="" class="btn btn-primary btn-sm rounded-pill px-3">
                        <i class="fa-solid fa-magnifying-glass-dollar me-1"></i>ไปหน้าตรวจสลิป
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal 2: Quick Reject Slip Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form method="post" asp-action="RejectSlip">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" id="rejectOrderIdInput" value="" />

                <div class="modal-header border-bottom py-3 bg-danger bg-opacity-10">
                    <h5 class="modal-title fw-bold text-danger" id="rejectModalLabel">
                        <i class="fa-solid fa-circle-exclamation me-2"></i>ปฏิเสธสลิปคำสั่งซื้อ <span id="rejectModalOrderId"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="alert alert-warning py-2 px-3 small rounded-3 mb-3">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>ระบบจะปรับสถานะออเดอร์เป็น <strong>Invalid Slip</strong> และส่งแจ้งเตือนให้ลูกค้าแนบสลิปใหม่
                    </div>

                    <label class="form-label fw-semibold small text-dark">เลือกเหตุผลที่พบบ่อย:</label>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" onclick="setRejectReason('ยอดเงินโอนไม่ตรงกับยอดคำสั่งซื้อ')">
                            ยอดเงินไม่ตรง
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" onclick="setRejectReason('ภาพสลิปไม่ชัดเจน / มัว อ่านข้อมูลไม่ได้')">
                            ภาพไม่ชัดเจน
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" onclick="setRejectReason('สลิปซ้ำกับรายการอื่น หรือมีการใช้งานไปแล้ว')">
                            สลิปซ้ำ
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" onclick="setRejectReason('บัญชีปลายทางไม่ถูกต้อง ไม่ใช่บัญชีของร้าน')">
                            โอนผิดบัญชี
                        </button>
                    </div>

                    <label for="rejectReasonArea" class="form-label fw-semibold small text-dark">รายละเอียด / ข้อความแจ้งลูกค้า:</label>
                    <textarea name="reason" id="rejectReasonArea" rows="3" class="form-control rounded-3" 
                              placeholder="ระบุเหตุผล เช่น ยอดเงินโอน ฿500 ขาดจากยอดคำสั่งซื้อ ฿590 โปรดโอนเพิ่มหรือแนบสลิปใหม่..." required></textarea>
                </div>

                <div class="modal-footer bg-white border-top">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-danger btn-sm rounded-pill px-4 fw-semibold">
                        <i class="fa-solid fa-ban me-1"></i>ยืนยันปฏิเสธสลิป
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewSlip(el) {
            var url = el.getAttribute('data-slip-url');
            var orderId = el.getAttribute('data-order-id');
            var orderTotal = el.getAttribute('data-order-total');
            var customerName = el.getAttribute('data-customer-name');

            document.getElementById('modalSlipImg').src = url;
            document.getElementById('modalOrderId').innerText = '#' + orderId;
            document.getElementById('modalOrderTotal').innerText = orderTotal;
            document.getElementById('modalCustomerName').innerText = customerName;
            document.getElementById('modalFullLink').href = url;
            document.getElementById('modalVerifyDetailLink').href = '@Url.Action("VerifySlip", "Accounting")/' + orderId;
        }

        function prepareRejectModal(el) {
            var orderId = el.getAttribute('data-order-id');
            document.getElementById('rejectOrderIdInput').value = orderId;
            document.getElementById('rejectModalOrderId').innerText = '#' + orderId;
            document.getElementById('rejectReasonArea').value = '';
        }

        function setRejectReason(text) {
            document.getElementById('rejectReasonArea').value = text;
        }
    </script>
}
