@model List<waranon_csi402.Models.Order>
@{
    ViewData["Title"] = "รายงานการเงินและสรุปรายรับ - Accounting";
    Layout = "_LayoutAccounting";

    decimal totalRevenue = ViewBag.TotalRevenue ?? 0;
    int totalOrders = ViewBag.TotalOrders ?? 0;
    decimal totalDiscount = ViewBag.TotalDiscount ?? 0;
    decimal totalShippingFee = ViewBag.TotalShippingFee ?? 0;
    decimal subtotalSum = Model.Sum(o => o.Subtotal);
}

<div class="container-fluid p-0">
    <!-- Header (Screen only) -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2 d-print-none">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="fa-solid fa-chart-pie text-info me-2"></i>รายงานสรุปการเงินและรายรับ
            </h3>
            <p class="text-secondary small mb-0">ฝ่ายบัญชี: สรุปผลการดำเนินงาน ยอดชำระเงิน และรายการที่อนุมัติเข้าคลังสินค้าแล้ว</p>
        </div>

        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-outline-dark btn-sm rounded-pill px-3 shadow-sm">
                <i class="fa-solid fa-print me-1"></i>พิมพ์รายงาน / PDF
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm">
                <i class="fa-solid fa-arrow-left me-1"></i>กลับหน้าคิวงาน
            </a>
        </div>
    </div>

    <!-- Print Header (Print only) -->
    <div class="d-none d-print-block mb-4 border-bottom pb-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3 class="fw-bold mb-0 text-dark">เสื้อผ้า.com</h3>
                <div class="small text-muted">ระบบรายงานการเงินและรายรับประจำฝ่ายบัญชี (Financial & Revenue Report)</div>
            </div>
            <div class="text-end small">
                <div>วันที่พิมพ์รายงาน: <strong>@DateTime.Now.ToString("dd/MM/yyyy HH:mm น.")</strong></div>
                <div>ผู้จัดพิมพ์: <strong>@(TempData.Peek("Name") ?? "ฝ่ายบัญชีและการเงิน")</strong></div>
            </div>
        </div>
    </div>

    <!-- 4 Summary Stat Cards -->
    <div class="row g-3 mb-4">
        <!-- 1. รายรับสุทธิ -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white stat-card-acc h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold d-block mb-1">รายรับสุทธิที่อนุมัติ</span>
                        <h3 class="fw-bold text-success mb-0">฿@totalRevenue.ToString("N0")</h3>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-4 d-print-none">
                        <i class="fa-solid fa-wallet fs-4"></i>
                    </div>
                </div>
                <small class="text-muted mt-2 d-block" style="font-size: 0.75rem;">
                    (สถานะ Paid, Processing, Shipped, Completed)
                </small>
            </div>
        </div>

        <!-- 2. จำนวนคำสั่งซื้อ -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white stat-card-acc h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold d-block mb-1">จำนวนออเดอร์ที่ชำระแล้ว</span>
                        <h3 class="fw-bold text-primary mb-0">@totalOrders <span class="fs-6 fw-normal text-muted">รายการ</span></h3>
                    </div>
                    <div class="bg-primary-subtle text-primary p-3 rounded-4 d-print-none">
                        <i class="fa-solid fa-cart-check fs-4"></i>
                    </div>
                </div>
                <small class="text-muted mt-2 d-block" style="font-size: 0.75rem;">
                    เฉลี่ย ฿@(totalOrders > 0 ? (totalRevenue / totalOrders).ToString("N0") : "0") ต่อคำสั่งซื้อ
                </small>
            </div>
        </div>

        <!-- 3. ส่วนลดโปรโมชั่นรวม -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white stat-card-acc h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold d-block mb-1">ส่วนลดโปรโมชั่นสะสม</span>
                        <h3 class="fw-bold text-danger mb-0">฿@totalDiscount.ToString("N0")</h3>
                    </div>
                    <div class="bg-danger-subtle text-danger p-3 rounded-4 d-print-none">
                        <i class="fa-solid fa-tag fs-4"></i>
                    </div>
                </div>
                <small class="text-muted mt-2 d-block" style="font-size: 0.75rem;">
                    (โปรโมชั่น P1-P5 และโค้ดคูปอง)
                </small>
            </div>
        </div>

        <!-- 4. รายรับจากค่าจัดส่ง -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white stat-card-acc h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold d-block mb-1">รายรับจากค่าจัดส่ง</span>
                        <h3 class="fw-bold text-dark mb-0">฿@totalShippingFee.ToString("N0")</h3>
                    </div>
                    <div class="bg-secondary-subtle text-secondary p-3 rounded-4 d-print-none">
                        <i class="fa-solid fa-truck-fast fs-4"></i>
                    </div>
                </div>
                <small class="text-muted mt-2 d-block" style="font-size: 0.75rem;">
                    (สำหรับคำสั่งซื้อยอดไม่ถึงเกณฑ์ส่งฟรี)
                </small>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-receipt text-info me-2"></i>บันทึกรายการรายรับจากการชำระเงิน
            </h5>
            <span class="badge bg-light text-dark border">รวม @Model.Count รายการ</span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-inbox fa-3x opacity-50 mb-3"></i>
                    <h5 class="fw-bold">ยังไม่มีรายการชำระเงินที่อนุมัติแล้ว</h5>
                    <p class="small mb-0">เมื่อฝ่ายบัญชีอนุมัติสลิปโอนเงิน รายการจะปรากฏในหน้านี้โดยอัตโนมัติ</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-muted text-uppercase">
                            <tr>
                                <th class="ps-4 py-3">#ออเดอร์</th>
                                <th class="py-3">ชื่อลูกค้า</th>
                                <th class="py-3">วันที่ชำระเงิน</th>
                                <th class="py-3">ช่องทาง</th>
                                <th class="py-3 text-end">ยอดสินค้า</th>
                                <th class="py-3 text-end">ส่วนลด</th>
                                <th class="py-3 text-end">ค่าจัดส่ง</th>
                                <th class="py-3 text-end">ยอดสุทธิ</th>
                                <th class="pe-4 py-3 text-center d-print-none">สถานะ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">
                                        <a asp-action="VerifySlip" asp-route-id="@o.OrderId" class="text-primary text-decoration-none">
                                            #@o.OrderId
                                        </a>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">
                                            @(o.User?.FirstName ?? "ลูกค้า") @(o.User?.LastName ?? "")
                                        </div>
                                        <small class="text-muted">@(o.User?.Email ?? "-")</small>
                                    </td>
                                    <td class="small">
                                        <div>@o.OrderedAt.ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted">@o.OrderedAt.ToString("HH:mm น.")</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@o.PaymentMethod</span>
                                    </td>
                                    <td class="text-end small">฿@o.Subtotal.ToString("N0")</td>
                                    <td class="text-end small @(o.DiscountAmt > 0 ? "text-danger fw-semibold" : "text-muted")">
                                        @(o.DiscountAmt > 0 ? $"-฿{o.DiscountAmt:N0}" : "฿0")
                                    </td>
                                    <td class="text-end small">฿@o.ShippingFee.ToString("N0")</td>
                                    <td class="text-end fw-bold text-success fs-6">฿@o.TotalAmount.ToString("N0")</td>
                                    <td class="pe-4 text-center d-print-none">
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">
                                            @o.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="4" class="ps-4 py-3 text-end">รวมทั้งสิ้น:</td>
                                <td class="text-end py-3">฿@subtotalSum.ToString("N0")</td>
                                <td class="text-end text-danger py-3">-฿@totalDiscount.ToString("N0")</td>
                                <td class="text-end py-3">฿@totalShippingFee.ToString("N0")</td>
                                <td class="text-end text-success fs-5 py-3">฿@totalRevenue.ToString("N0")</td>
                                <td class="pe-4 d-print-none"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Print Footer: Accountant Signatures (Print only) -->
    <div class="d-none d-print-block mt-5 pt-4">
        <div class="row text-center">
            <div class="col-6">
                <div class="mb-5">......................................................................</div>
                <div class="fw-bold">(@(TempData.Peek("Name") ?? "......................................................"))</div>
                <div class="small text-muted">เจ้าหน้าที่ฝ่ายบัญชีและการเงิน</div>
                <div class="small text-muted">วันที่: ...... / ...... / ............</div>
            </div>
            <div class="col-6">
                <div class="mb-5">......................................................................</div>
                <div class="fw-bold">(......................................................)</div>
                <div class="small text-muted">ผู้จัดการฝ่ายบัญชี / ผู้มีอำนาจลงนาม</div>
                <div class="small text-muted">วันที่: ...... / ...... / ............</div>
            </div>
        </div>
    </div>
</div>
