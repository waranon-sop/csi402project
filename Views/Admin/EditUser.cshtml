@model waranon_csi402.Models.User

@{
    ViewData["Title"] = "แก้ไขผู้ใช้งาน #" + Model.UserId;
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4" style="max-width: 720px; margin: 0 auto;">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="UserList" class="text-decoration-none">จัดการผู้ใช้งาน</a></li>
                <li class="breadcrumb-item active" aria-current="page">แก้ไขผู้ใช้งาน #@Model.UserId</li>
            </ol>
        </nav>
        <h3 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-user-pen text-warning me-2"></i>แก้ไขข้อมูลผู้ใช้งาน
        </h3>
    </div>
    <a asp-action="UserList" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        <i class="fa-solid fa-arrow-left me-1"></i>ย้อนกลับ
    </a>
</div>

<div class="card card-custom p-4 shadow-sm" style="max-width: 720px; margin: 0 auto;">
    @if (ViewBag.Status != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@ViewBag.Status
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="EditUser" asp-controller="Admin" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold text-dark">ชื่อ (First Name) <span class="text-danger">*</span></label>
                <input type="text" asp-for="FirstName" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold text-dark">นามสกุล (Last Name) <span class="text-danger">*</span></label>
                <input type="text" asp-for="LastName" class="form-control" required />
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold text-dark">อีเมล (Email) <span class="text-danger">*</span></label>
                <input type="email" asp-for="Email" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold text-dark">เบอร์โทรศัพท์ (Phone)</label>
                <input type="text" asp-for="PhoneNumber" class="form-control" />
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label fw-semibold text-dark">เปลี่ยนรหัสผ่านใหม่</label>
                @* ไม่ดึงรหัสผ่านเดิมมาแสดง (DB เก็บเป็น Hash) — กรอกเฉพาะเมื่อต้องการตั้งรหัสใหม่ *@
                <input type="password" name="Password" value="" autocomplete="new-password" class="form-control" placeholder="เว้นว่างไว้หากไม่ต้องการเปลี่ยน" />
                <div class="form-text">กรอกเฉพาะกรณีต้องการรีเซ็ตรหัสผ่านให้ผู้ใช้</div>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold text-dark">บทบาทผู้ใช้งาน (Role)</label>
                <select asp-for="Role" class="form-select">
                    <option value="Customer">ลูกค้าทั่วไป (Customer)</option>
                    <option value="Admin">ผู้ดูแลระบบ (Admin)</option>
                    <option value="Staff">เจ้าหน้าที่จัดการคลัง (Staff)</option>
                    <option value="Accounting">เจ้าหน้าที่ฝ่ายการเงิน (Accounting)</option>
                </select>
            </div>
        </div>

        <div class="d-flex gap-2 pt-2 border-top">
            <button type="submit" class="btn btn-warning px-4 py-2 rounded-pill fw-bold text-dark shadow-sm">
                <i class="fa-solid fa-check me-1"></i> บันทึกการแก้ไข
            </button>
            <a asp-action="UserList" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                ยกเลิก
            </a>
        </div>
    </form>
</div>
