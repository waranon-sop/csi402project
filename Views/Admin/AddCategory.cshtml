@model waranon_csi402.Models.Category

@{
    ViewData["Title"] = "เพิ่มหมวดหมู่สินค้า";
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4" style="max-width: 680px; margin: 0 auto;">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="CategoryList" class="text-decoration-none">จัดการหมวดหมู่</a></li>
                <li class="breadcrumb-item active" aria-current="page">เพิ่มหมวดหมู่</li>
            </ol>
        </nav>
        <h3 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-folder-plus text-primary me-2"></i>เพิ่มหมวดหมู่สินค้าใหม่
        </h3>
    </div>
    <a asp-action="CategoryList" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        <i class="fa-solid fa-arrow-left me-1"></i>ย้อนกลับ
    </a>
</div>

<div class="card card-custom p-4 shadow-sm" style="max-width: 680px; margin: 0 auto;">
    @if (ViewBag.Status != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@ViewBag.Status
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="AddCategory" asp-controller="Admin" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label fw-semibold text-dark">ชื่อหมวดหมู่สินค้า <span class="text-danger">*</span></label>
            <input type="text" name="CategoryName" value="@Model?.CategoryName" class="form-control form-control-lg fs-6" 
                   placeholder="เช่น เสื้อยืด (T-Shirts), เสื้อเชิ้ต (Shirts)" required />
            <div class="form-text">ชื่อหมวดหมู่จะแสดงเป็นปุ่มตัวกรองในหน้าแรกและเมนูของลูกค้า</div>
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold text-dark">คำอธิบายหมวดหมู่</label>
            <textarea name="Description" class="form-control" rows="3" 
                      placeholder="ระบุรายละเอียดเพิ่มเติมเกี่ยวกับเสื้อผ้าในหมวดหมู่นี้...">@Model?.Description</textarea>
        </div>

        <div class="d-flex gap-2 pt-2 border-top">
            <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill fw-bold shadow-sm">
                <i class="fa-solid fa-floppy-disk me-1"></i> บันทึกหมวดหมู่
            </button>
            <a asp-action="CategoryList" asp-controller="Admin" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                ยกเลิก
            </a>
        </div>
    </form>
</div>
