@model IEnumerable<waranon_csi402.Models.Promotion>

@{
    ViewData["Title"] = "จัดการโปรโมชั่น & โค้ดส่วนลด";
    Layout = "_LayoutAdmin";
    var coupons = ViewBag.Coupons as List<waranon_csi402.Models.Coupon> ?? new List<waranon_csi402.Models.Coupon>();
    string activeTab = ViewBag.ActiveTab as string ?? "promotions";
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-ticket text-danger me-2"></i>จัดการโปรโมชั่น & โค้ดส่วนลด
        </h3>
        <p class="text-muted small mb-0">
            ระบบคำนวณส่วนลดอัตโนมัติ และจัดการโค้ดคูปองส่วนลดสำหรับลูกค้า
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="AddPromotion" class="btn btn-primary rounded-pill px-3 shadow-sm fw-medium">
            <i class="fa-solid fa-plus me-1"></i>เพิ่มโปรโมชั่นใหม่
        </a>
        <a asp-action="AddCoupon" class="btn btn-outline-danger rounded-pill px-3 shadow-sm fw-medium">
            <i class="fa-solid fa-tag me-1"></i>สร้างโค้ดคูปอง
        </a>
    </div>
</div>

@if (ViewBag.Status != null)
{
    <div class="alert alert-info alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="fa-solid fa-circle-info me-2"></i>@ViewBag.Status
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- คำอธิบายเงื่อนไขสั้นกระชับ -->
<div class="alert alert-light border small text-muted mb-3 py-2">
    <i class="fa-solid fa-circle-info text-primary me-1"></i>ระบบจะเลือกโปรโมชั่นหรือโค้ดส่วนลดที่ให้ส่วนลดสูงสุดเพียง 1 สิทธิ์ต่อ 1 คำสั่งซื้อ (คำนวณจากยอดรวมก่อนบวกค่าส่ง)
</div>

<!-- Tabs สลับดู โปรโมชั่นอัตโนมัติ / โค้ดคูปอง -->
<ul class="nav nav-pills mb-3 gap-2" id="promoTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab != "coupons" ? "active" : "") rounded-pill px-4 fw-medium" id="promotions-tab" data-bs-toggle="pill" data-bs-target="#promotionsPane" type="button" role="tab">
            <i class="fa-solid fa-bolt text-warning me-2"></i>โปรโมชั่นอัตโนมัติของร้าน (@Model.Count() รายการ)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "coupons" ? "active" : "") rounded-pill px-4 fw-medium" id="coupons-tab" data-bs-toggle="pill" data-bs-target="#couponsPane" type="button" role="tab">
            <i class="fa-solid fa-tag text-danger me-2"></i>โค้ดคูปองส่วนลด (@coupons.Count โค้ด)
        </button>
    </li>
</ul>

<div class="tab-content" id="promoTabsContent">
    <!-- ========================================== -->
    <!-- Tab 1: โปรโมชั่นอัตโนมัติ (P1 - P5) -->
    <!-- ========================================== -->
    <div class="tab-pane fade @(activeTab != "coupons" ? "show active" : "")" id="promotionsPane" role="tabpanel">
        <div class="card card-custom overflow-hidden">
            <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
                <span class="fw-bold text-dark">รายการโปรโมชั่นคำนวณอัตโนมัติ (Auto Promotions)</span>
                <a asp-action="AddPromotion" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                    <i class="fa-solid fa-plus me-1"></i>เพิ่มโปรโมชั่น
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-custom table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width: 70px;">#</th>
                                <th>ชื่อแคมเปญโปรโมชั่น</th>
                                <th>ส่วนลด</th>
                                <th>ยอดซื้อขั้นต่ำ (Subtotal)</th>
                                <th>หมวดหมู่สินค้า</th>
                                <th>สถานะใช้งาน</th>
                                <th class="text-center" style="width: 160px;">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-ticket fa-3x mb-3 d-block opacity-50"></i>
                                        ยังไม่มีข้อมูลโปรโมชั่นในระบบ
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var p in Model)
                                {
                                    <tr>
                                        <td class="fw-bold text-secondary">#@p.PromotionId</td>
                                        <td>
                                            <div class="fw-bold text-dark">@p.PromotionName</div>
                                            @if (p.StartDate.HasValue || p.EndDate.HasValue)
                                            {
                                                <small class="text-muted">
                                                    ระยะเวลา: @(p.StartDate?.ToString("dd/MM/yyyy") ?? "-") ถึง @(p.EndDate?.ToString("dd/MM/yyyy") ?? "ไม่มีกำหนด")
                                                </small>
                                            }
                                        </td>
                                        <td>
                                            @if (p.DiscountType == "Percent" || p.DiscountType == "Percentage")
                                            {
                                                <span class="badge badge-soft-danger fs-6 px-3 py-1 rounded-pill">
                                                    ลด @p.DiscountValue.ToString("N0")%
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-soft-success fs-6 px-3 py-1 rounded-pill">
                                                    ลด ฿@p.DiscountValue.ToString("N0")
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (p.MinOrderAmt > 0)
                                            {
                                                <strong class="text-dark">฿@p.MinOrderAmt.ToString("N0")</strong>
                                            }
                                            else
                                            {
                                                <span class="text-muted">ไม่กำหนดยอดขั้นต่ำ</span>
                                            }
                                        </td>
                                        <td>
                                            @if (p.Category != null)
                                            {
                                                <span class="badge badge-soft-secondary rounded-pill">@p.Category.CategoryName</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">ทุกหมวดหมู่</span>
                                            }
                                        </td>
                                        <td>
                                            <form asp-action="TogglePromotionStatus" asp-controller="Admin" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@p.PromotionId" />
                                                @if (p.IsActive == true || p.IsActive == null)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 py-1 shadow-sm text-nowrap" 
                                                            title="คลิกเพื่อปิดใช้งานโปรโมชั่นนี้">
                                                        <i class="fa-solid fa-circle-check me-1"></i>เปิดใช้งาน
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 text-nowrap" 
                                                            title="คลิกเพื่อเปิดใช้งานโปรโมชั่นนี้">
                                                        <i class="fa-solid fa-circle-xmark me-1 text-danger"></i>ปิดใช้งาน
                                                    </button>
                                                }
                                            </form>
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-1">
                                                <a asp-action="EditPromotion" asp-controller="Admin" asp-route-id="@p.PromotionId" 
                                                   class="btn btn-sm btn-outline-warning rounded-pill px-3" title="แก้ไข">
                                                    <i class="fa-solid fa-pen"></i>
                                                </a>
                                                <form method="post" asp-action="DeletePromotion" asp-controller="Admin" asp-route-id="@p.PromotionId" class="d-inline"
                                                      onsubmit="return confirm('ยืนยันว่าต้องการลบโปรโมชั่น @p.PromotionName หรือไม่?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="ลบ">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- Tab 2: โค้ดส่วนลด (Coupons) -->
    <!-- ========================================== -->
    <div class="tab-pane fade @(activeTab == "coupons" ? "show active" : "")" id="couponsPane" role="tabpanel">
        <div class="card card-custom overflow-hidden">
            <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
                <span class="fw-bold text-dark">รายการโค้ดส่วนลด (Promo Codes)</span>
                <a asp-action="AddCoupon" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                    <i class="fa-solid fa-plus me-1"></i>สร้างโค้ดคูปอง
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-custom table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width: 70px;">#</th>
                                <th>รหัสคูปอง (Coupon Code)</th>
                                <th>ส่วนลด</th>
                                <th>ยอดซื้อขั้นต่ำ</th>
                                <th>สิทธิ์การใช้งาน</th>
                                <th>วันหมดอายุ</th>
                                <th>สถานะ</th>
                                <th class="text-center" style="width: 160px;">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!coupons.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-tag fa-3x mb-3 d-block opacity-50"></i>
                                        ยังไม่มีโค้ดคูปองส่วนลดในระบบ
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var c in coupons)
                                {
                                    <tr>
                                        <td class="fw-bold text-secondary">#@c.CouponId</td>
                                        <td>
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 fs-6 px-3 py-2 rounded-3 fw-bold font-monospace">
                                                <i class="fa-solid fa-ticket me-1"></i>@c.CouponCode
                                            </span>
                                        </td>
                                        <td>
                                            @if (c.DiscountType == "Percent" || c.DiscountType == "Percentage")
                                            {
                                                <strong class="text-danger">ลด @c.DiscountValue.ToString("N0")%</strong>
                                            }
                                            else
                                            {
                                                <strong class="text-success">ลด ฿@c.DiscountValue.ToString("N0")</strong>
                                            }
                                        </td>
                                        <td>
                                            <strong>฿@c.MinOrderAmt.ToString("N0")</strong>
                                        </td>
                                        <td>
                                            <div>
                                                <span class="small fw-semibold">ใช้แล้ว @c.UsedCount ครั้ง</span>
                                                @if (c.UsageLimit.HasValue && c.UsageLimit.Value > 0)
                                                {
                                                    <small class="text-muted d-block">จำกัด @c.UsageLimit.Value สิทธิ์</small>
                                                }
                                                else
                                                {
                                                    <small class="text-muted d-block">ไม่จำกัดจำนวนสิทธิ์</small>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            @if (c.ExpiresAt.HasValue)
                                            {
                                                var isExpired = c.ExpiresAt.Value < DateTime.Now;
                                                <span class="@(isExpired ? "text-danger fw-semibold" : "text-muted") small">
                                                    @c.ExpiresAt.Value.ToString("dd/MM/yyyy HH:mm")
                                                    @if (isExpired) { <span class="badge bg-danger ms-1">หมดอายุ</span> }
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">ไม่มีวันหมดอายุ</span>
                                            }
                                        </td>
                                        <td>
                                            <form asp-action="ToggleCouponStatus" asp-controller="Admin" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@c.CouponId" />
                                                @if (c.IsActive == true || c.IsActive == null)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 py-1 shadow-sm text-nowrap" 
                                                            title="คลิกเพื่อปิดใช้งานคูปองนี้">
                                                        <i class="fa-solid fa-circle-check me-1"></i>เปิดใช้งาน
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 text-nowrap" 
                                                            title="คลิกเพื่อเปิดใช้งานคูปองนี้">
                                                        <i class="fa-solid fa-circle-xmark me-1 text-danger"></i>ปิดใช้งาน
                                                    </button>
                                                }
                                            </form>
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-1">
                                                <a asp-action="EditCoupon" asp-controller="Admin" asp-route-id="@c.CouponId" 
                                                   class="btn btn-sm btn-outline-warning rounded-pill px-3" title="แก้ไข">
                                                    <i class="fa-solid fa-pen"></i>
                                                </a>
                                                <form method="post" asp-action="DeleteCoupon" asp-controller="Admin" asp-route-id="@c.CouponId" class="d-inline"
                                                      onsubmit="return confirm('ยืนยันว่าต้องการลบคูปอง @c.CouponCode หรือไม่?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="ลบ">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // จดจำแท็บที่เปิดล่าสุดเมื่อกดคลิกสลับแท็บ
        const tabButtons = document.querySelectorAll('#promoTabs button[data-bs-toggle="pill"]');
        tabButtons.forEach(btn => {
            btn.addEventListener('shown.bs.tab', function (e) {
                const targetId = e.target.getAttribute('id');
                sessionStorage.setItem('admin_promo_active_tab', targetId);
            });
        });
    </script>
}

