@model waranon_csi402.Models.Product

@{
    ViewData["Title"] = "เพิ่มสินค้าใหม่";
    Layout = "_LayoutAdmin";
    var categories = ViewBag.Categories as List<waranon_csi402.Models.Category> ?? new List<waranon_csi402.Models.Category>();
}

<!-- Page Header & Back Button -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="ProductList" class="text-decoration-none">จัดการสินค้า</a></li>
                <li class="breadcrumb-item active" aria-current="page">เพิ่มสินค้าใหม่</li>
            </ol>
        </nav>
        <h3 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-plus-circle text-primary me-2"></i>เพิ่มสินค้าใหม่ (Add Product)
        </h3>
    </div>
    <a asp-action="ProductList" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        <i class="fa-solid fa-arrow-left me-1"></i>กลับหน้ารายการสินค้า
    </a>
</div>

@if (ViewBag.Status != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@ViewBag.Status
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-action="AddProduct" asp-controller="Admin" method="post">
    @Html.AntiForgeryToken()

    <div class="row g-4 mb-5">
        <!-- ฝั่งซ้าย: ข้อมูลสินค้าและ SKU เริ่มต้น -->
        <div class="col-lg-8">
            <div class="card card-custom p-4 mb-4">
                <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                    <i class="fa-solid fa-file-lines text-primary me-2"></i>ข้อมูลทั่วไปของสินค้า
                </h5>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark">ชื่อสินค้า <span class="text-danger">*</span></label>
                    <input type="text" name="ProductName" value="@Model?.ProductName" class="form-control form-control-lg fs-6" 
                           placeholder="เช่น เสื้อยืด Oversize มินิมอล Cotton 100%" required />
                    <div class="form-text">ชื่อสินค้าจะแสดงเป็นหัวข้อหลักที่หน้าร้านค้า</div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark">หมวดหมู่สินค้า <span class="text-danger">*</span></label>
                        <select name="CategoryId" class="form-select" required>
                            <option value="">-- เลือกหมวดหมู่ --</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c.CategoryId" selected="@(Model?.CategoryId == c.CategoryId)">
                                    @c.CategoryName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark">ราคาตั้งต้น (Base Price) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light fw-bold text-muted">฿</span>
                            <input type="number" step="0.01" min="0" name="BasePrice" value="@(Model?.BasePrice > 0 ? Model.BasePrice : 290)" 
                                   class="form-control" required />
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark">คำอธิบายและจุดเด่นของสินค้า</label>
                    <textarea name="Description" class="form-control" rows="4" 
                              placeholder="ระบุชนิดเนื้อผ้า ทรงเสื้อ และคุณสมบัติเด่นที่ลูกค้าควรรู้...">@Model?.Description</textarea>
                </div>
            </div>

            <!-- กล่องกำหนด Initial SKU -->
            <div class="card card-custom p-4">
                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="fa-solid fa-tags text-info me-2"></i>กำหนดตัวเลือกสินค้าแรก (Initial SKU)
                    </h5>
                    <span class="badge badge-soft-primary small">ระบบสร้างให้อัตโนมัติ</span>
                </div>
                <p class="text-muted small mb-3">
                    เพื่อให้สินค้าสามารถเลือกซื้อที่หน้าร้านได้ทันที กรุณากำหนดสีและไซส์เริ่มต้น (คุณสามารถเพิ่มตัวเลือกอื่นๆ ต่อได้ในหน้าจัดการ SKU)
                </p>

                <div class="row g-3 bg-light p-3 rounded-3 border">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-dark">สีเริ่มต้น</label>
                        <input type="text" name="defaultColor" value="ดำ" class="form-control form-control-sm" placeholder="เช่น ดำ, ขาว, กรม" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-dark">ไซส์เริ่มต้น</label>
                        <input type="text" name="defaultSize" value="Free Size" class="form-control form-control-sm" placeholder="เช่น S, M, L, XL, Free Size" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-dark">สต็อกเริ่มต้น (ชิ้น)</label>
                        <input type="number" min="0" name="defaultStock" value="20" class="form-control form-control-sm" />
                    </div>
                </div>
            </div>
        </div>

        <!-- ฝั่งขวา: ลิงก์รูปภาพ & พรีวิว & สถานะ -->
        <div class="col-lg-4">
            <!-- สถานะสินค้า -->
            <div class="card card-custom p-4 mb-4">
                <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom">สถานะการวางขาย</h6>
                <div class="mb-3">
                    <select name="IsActive" class="form-select">
                        <option value="true" selected>🟢 เปิดขายทันที (Active)</option>
                        <option value="false">⚪ ปิดการขายชั่วคราว (Draft)</option>
                    </select>
                </div>
            </div>

            <!-- รูปภาพสินค้าพร้อม Live Preview -->
            <div class="card card-custom p-4 mb-4">
                <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom">รูปภาพสินค้า (Image URL)</h6>

                <div class="mb-3">
                    <label class="form-label small text-muted">ใส่ลิงก์รูปภาพ (Direct URL)</label>
                    <input type="url" id="imageUrlInput" name="ImageUrl" value="@Model?.ImageUrl" class="form-control form-control-sm" 
                           placeholder="https://images.unsplash.com/photo-..." oninput="previewImage(this.value)" />
                </div>

                <div class="text-center p-3 bg-light rounded-3 border">
                    <div id="imagePlaceholder" class="py-4 text-muted">
                        <i class="fa-solid fa-image fa-3x mb-2 opacity-50"></i>
                        <p class="small mb-0">ใส่ URL ด้านบนเพื่อดูพรีวิวรูปภาพ</p>
                    </div>
                    <div id="imagePreviewBox" class="d-none">
                        <img id="imgPreview" src="" alt="พรีวิวรูปภาพ" class="img-fluid rounded-3 shadow-sm" style="max-height: 220px; object-fit: contain;" 
                             onerror="onPreviewError()" />
                    </div>
                </div>
            </div>

            <!-- ปุ่มบันทึก -->
            <div class="card card-custom p-4">
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary py-2 fw-bold shadow-sm">
                        <i class="fa-solid fa-floppy-disk me-1"></i> บันทึกและสร้างสินค้า
                    </button>
                    <a asp-action="ProductList" class="btn btn-outline-secondary py-2">
                        ยกเลิก
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function previewImage(url) {
            const placeholder = document.getElementById('imagePlaceholder');
            const previewBox = document.getElementById('imagePreviewBox');
            const img = document.getElementById('imgPreview');

            if (url && url.trim().length > 5) {
                img.src = url.trim();
                placeholder.classList.add('d-none');
                previewBox.classList.remove('d-none');
            } else {
                placeholder.classList.remove('d-none');
                previewBox.classList.add('d-none');
            }
        }

        function onPreviewError() {
            const placeholder = document.getElementById('imagePlaceholder');
            const previewBox = document.getElementById('imagePreviewBox');
            placeholder.classList.remove('d-none');
            previewBox.classList.add('d-none');
        }

        // Run preview on load if value exists
        document.addEventListener("DOMContentLoaded", function () {
            const val = document.getElementById('imageUrlInput').value;
            if (val) previewImage(val);
        });
    </script>
}
