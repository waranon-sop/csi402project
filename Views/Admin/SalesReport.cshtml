@{
    ViewData["Title"] = "รายงานยอดขายและสถิติ";
    Layout = "_LayoutAdmin";

    decimal totalRevenue = ViewBag.TotalRevenue ?? 0m;
    int paidOrdersCount = ViewBag.PaidOrdersCount ?? 0;
    decimal todayRevenue = ViewBag.TodayRevenue ?? 0m;
    decimal monthRevenue = ViewBag.MonthRevenue ?? 0m;
    decimal avgOrderValue = ViewBag.AvgOrderValue ?? 0m;
    decimal totalDiscounts = ViewBag.TotalDiscounts ?? 0m;

    var topProducts = ViewBag.TopProducts as List<waranon_csi402.ViewModels.TopProductViewModel> ?? new List<waranon_csi402.ViewModels.TopProductViewModel>();
    var recentOrders = ViewBag.RecentOrders as List<waranon_csi402.Models.Order> ?? new List<waranon_csi402.Models.Order>();
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-chart-line text-success me-2"></i>รายงานยอดขายและสถิติร้านค้า
        </h3>
        <p class="text-muted small mb-0">รายงานสรุปรายได้ ยอดขายสินค้า และสถิติคำสั่งซื้อในร้าน เสื้อผ้า.com</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm" onclick="window.print()">
            <i class="fa-solid fa-print me-1"></i>พิมพ์รายงาน
        </button>
        <a asp-action="OrderList" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm fw-medium">
            <i class="fa-solid fa-cart-shopping me-1"></i>ดูรายการออเดอร์
        </a>
    </div>
</div>

<!-- 4 กล่องสรุปรายได้และสถิติหลัก -->
<div class="row g-3 mb-4">
    <!-- รายได้รวมสุทธิ -->
    <div class="col-sm-6 col-xl-3">
        <div class="card card-custom h-100 p-3">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="text-muted small fw-semibold">ยอดขายรวมสุทธิ</span>
                    <h3 class="fw-bold text-success mt-1 mb-0">฿@totalRevenue.ToString("N0")</h3>
                </div>
                <div class="bg-success bg-opacity-10 text-success rounded-3 p-3">
                    <i class="fa-solid fa-wallet fs-4"></i>
                </div>
            </div>
            <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                <span class="badge badge-soft-success small">จากออเดอร์ที่ชำระแล้ว</span>
                <span class="small fw-semibold text-dark">@paidOrdersCount ออเดอร์</span>
            </div>
        </div>
    </div>

    <!-- ยอดขายเดือนนี้ -->
    <div class="col-sm-6 col-xl-3">
        <div class="card card-custom h-100 p-3">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="text-muted small fw-semibold">ยอดขายเดือนนี้</span>
                    <h3 class="fw-bold text-primary mt-1 mb-0">฿@monthRevenue.ToString("N0")</h3>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                    <i class="fa-solid fa-calendar-days fs-4"></i>
                </div>
            </div>
            <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                <span class="badge badge-soft-primary small">เดือนปัจจุบัน</span>
                <span class="small text-muted">@DateTime.Now.ToString("MMMM yyyy")</span>
            </div>
        </div>
    </div>

    <!-- ยอดขายวันนี้ -->
    <div class="col-sm-6 col-xl-3">
        <div class="card card-custom h-100 p-3">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="text-muted small fw-semibold">ยอดขายวันนี้</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0">฿@todayRevenue.ToString("N0")</h3>
                </div>
                <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-3">
                    <i class="fa-solid fa-coins fs-4"></i>
                </div>
            </div>
            <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                <span class="badge badge-soft-warning small">วันนี้</span>
                <span class="small text-muted">@DateTime.Today.ToString("dd/MM/yyyy")</span>
            </div>
        </div>
    </div>

    <!-- ยอดเฉลี่ยต่อออเดอร์ (AOV) -->
    <div class="col-sm-6 col-xl-3">
        <div class="card card-custom h-100 p-3">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="text-muted small fw-semibold">ยอดเฉลี่ยต่อบิล (AOV)</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0">฿@avgOrderValue.ToString("N0")</h3>
                </div>
                <div class="bg-info bg-opacity-10 text-info rounded-3 p-3">
                    <i class="fa-solid fa-receipt fs-4"></i>
                </div>
            </div>
            <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                <span class="badge badge-soft-secondary small">ส่วนลดรวมที่ให้ลูกค้า</span>
                <span class="small fw-semibold text-danger">-฿@totalDiscounts.ToString("N0")</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <!-- ฝั่งซ้าย: 5 สินค้าขายดีที่สุด (Top 5 Best Selling) -->
    <div class="col-lg-6">
        <div class="card card-custom h-100 overflow-hidden">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="fa-solid fa-crown text-warning me-2"></i>5 สินค้าขายดีที่สุด (Best Sellers)
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-custom table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width: 50px;">อันดับ</th>
                                <th>สินค้า</th>
                                <th class="text-center">ยอดขาย (ชิ้น)</th>
                                <th class="text-end">ยอดเงินรวม</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!topProducts.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-shirt fa-3x mb-3 d-block opacity-50"></i>
                                        ยังไม่มีข้อมูลยอดขายสินค้าในขณะนี้
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int rank = 1;
                                @foreach (var prod in topProducts)
                                {
                                    <tr>
                                        <td>
                                            @if (rank == 1)
                                            {
                                                <span class="badge bg-warning text-dark rounded-circle p-2">🥇 1</span>
                                            }
                                            else if (rank == 2)
                                            {
                                                <span class="badge bg-secondary text-white rounded-circle p-2">🥈 2</span>
                                            }
                                            else if (rank == 3)
                                            {
                                                <span class="badge bg-danger bg-opacity-75 text-white rounded-circle p-2">🥉 3</span>
                                            }
                                            else
                                            {
                                                <span class="fw-bold text-muted ps-2">#@rank</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="rounded-3 overflow-hidden bg-light border me-2 flex-shrink-0" style="width: 40px; height: 40px;">
                                                    @if (!string.IsNullOrEmpty(prod.ImageUrl))
                                                    {
                                                        <img src="@prod.ImageUrl" alt="สินค้า" style="width:100%; height:100%; object-fit:cover;" />
                                                    }
                                                    else
                                                    {
                                                        <i class="fa-solid fa-shirt text-muted p-2"></i>
                                                    }
                                                </div>
                                                <div class="fw-bold text-dark text-truncate" style="max-width: 200px;">
                                                    @prod.ProductName
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge badge-soft-primary px-3 py-1 rounded-pill">
                                                @prod.TotalQuantity ชิ้น
                                            </span>
                                        </td>
                                        <td class="text-end fw-bold text-dark">
                                            ฿@(((decimal)prod.TotalSales).ToString("N0"))
                                        </td>
                                    </tr>
                                    rank++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ฝั่งขวา: รายการสั่งซื้อล่าสุด -->
    <div class="col-lg-6">
        <div class="card card-custom h-100 overflow-hidden">
            <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>ออเดอร์ล่าสุด
                </h5>
                <a asp-action="OrderList" class="btn btn-outline-primary btn-sm rounded-pill px-3">ดูทั้งหมด</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-custom table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>ออเดอร์</th>
                                <th>ลูกค้า</th>
                                <th>ยอดชำระ</th>
                                <th class="text-center">สถานะ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!recentOrders.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">ยังไม่มีรายการสั่งซื้อ</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var o in recentOrders)
                                {
                                    <tr>
                                        <td>
                                            <a asp-action="AdminOrderDetail" asp-route-id="@o.OrderId" class="fw-bold text-primary text-decoration-none">
                                                #@o.OrderId
                                            </a>
                                            <small class="text-muted d-block">@o.OrderedAt.ToString("dd/MM/yy HH:mm")</small>
                                        </td>
                                        <td>
                                            <span class="text-dark fw-medium small">@(o.User?.FirstName ?? "ลูกค้า")</span>
                                        </td>
                                        <td>
                                            <strong class="text-danger">฿@o.TotalAmount.ToString("N0")</strong>
                                        </td>
                                        <td class="text-center">
                                            @if (o.Status == "Paid" || o.Status == "Completed")
                                            {
                                                <span class="badge badge-soft-success px-2 py-1 rounded-pill small">@o.Status</span>
                                            }
                                            else if (o.Status == "Pending Payment" || o.Status == "Verifying Slip")
                                            {
                                                <span class="badge badge-soft-warning px-2 py-1 rounded-pill small">@o.Status</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-soft-secondary px-2 py-1 rounded-pill small">@o.Status</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

