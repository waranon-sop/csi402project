@model waranon_csi402.Models.User

@{
    ViewData["Title"] = "ข้อมูลส่วนตัว & สมุดที่อยู่";
    Layout = "_Layout2";

    string currentTab = ViewBag.CurrentTab ?? "profile";
    var addresses = ViewBag.Addresses as List<waranon_csi402.Models.Address> ?? new List<waranon_csi402.Models.Address>();
    int orderCount = ViewBag.OrderCount ?? 0;
    int wishlistCount = ViewBag.WishlistCount ?? 0;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">หน้าแรก</a></li>
            <li class="breadcrumb-item active" aria-current="page">บัญชีของฉัน</li>
        </ol>
    </nav>

    <!-- Notification Alerts -->
    @if (!string.IsNullOrEmpty(ViewBag.Status))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="fa-solid fa-circle-check fs-4 me-3 text-success"></i>
            <div class="flex-grow-1">
                <span class="fw-medium">@ViewBag.Status</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="fa-solid fa-circle-exclamation fs-4 me-3 text-danger"></i>
            <div class="flex-grow-1">
                <span class="fw-medium">@ViewBag.Error</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 56px; height: 56px; font-size: 1.5rem;">
                <i class="fa-solid fa-user"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0 text-dark">@Model.FirstName @Model.LastName</h3>
                <p class="text-secondary small mb-0">
                    <i class="fa-solid fa-envelope me-1 text-muted"></i>@Model.Email
                    <span class="mx-2">•</span>
                    <span class="badge bg-primary bg-opacity-10 text-primary">@Model.Role</span>
                </p>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <a asp-controller="Cart" asp-action="MyOrders" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm">
                <i class="fa-solid fa-receipt me-1"></i>ดูคำสั่งซื้อของฉัน (@orderCount)
            </a>
            <a asp-controller="Home" asp-action="Wishlist" class="btn btn-outline-danger btn-sm rounded-pill px-3 shadow-sm">
                <i class="fa-solid fa-heart me-1"></i>รายการโปรด (@wishlistCount)
            </a>
        </div>
    </div>

    <!-- Main Navigation Tabs Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white border-bottom p-3">
            <ul class="nav nav-pills gap-2">
                <li class="nav-item">
                    <a class="nav-link rounded-pill py-2 px-4 @(currentTab == "profile" ? "active bg-primary fw-bold" : "text-secondary")"
                       asp-action="Profile" asp-route-tab="profile">
                        <i class="fa-solid fa-id-card me-2"></i>ข้อมูลส่วนตัว
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link rounded-pill py-2 px-4 @(currentTab == "address" ? "active bg-primary fw-bold" : "text-secondary")"
                       asp-action="Profile" asp-route-tab="address">
                        <i class="fa-solid fa-map-location-dot me-2"></i>สมุดที่อยู่จัดส่ง
                        <span class="badge @(currentTab == "address" ? "bg-white text-primary" : "bg-light text-dark") ms-1">@addresses.Count</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link rounded-pill py-2 px-4 @(currentTab == "password" ? "active bg-primary fw-bold" : "text-secondary")"
                       asp-action="Profile" asp-route-tab="password">
                        <i class="fa-solid fa-key me-2"></i>เปลี่ยนรหัสผ่าน
                    </a>
                </li>
            </ul>
        </div>

        <div class="card-body p-4">
            <!-- ============================================== -->
            <!-- TAB 1: ข้อมูลส่วนตัว (Profile Info) -->
            <!-- ============================================== -->
            @if (currentTab == "profile")
            {
                <div class="row">
                    <div class="col-lg-8">
                        <h5 class="fw-bold mb-3 text-dark">
                            <i class="fa-solid fa-user-pen text-primary me-2"></i>แก้ไขข้อมูลส่วนตัว
                        </h5>
                        <form method="post" asp-action="UpdateProfile">
                            @Html.AntiForgeryToken()
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">ชื่อ <span class="text-danger">*</span></label>
                                    <input type="text" name="firstName" class="form-control form-control-lg rounded-3" value="@Model.FirstName" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">นามสกุล <span class="text-danger">*</span></label>
                                    <input type="text" name="lastName" class="form-control form-control-lg rounded-3" value="@Model.LastName" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">อีเมล (ใช้เข้าสู่ระบบ)</label>
                                    <input type="email" class="form-control form-control-lg rounded-3 bg-light" value="@Model.Email" readonly />
                                    <small class="text-muted">ไม่สามารถเปลี่ยนอีเมลได้ เนื่องจากใช้เป็นบัญชีหลัก</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">เบอร์โทรศัพท์ติดต่อ</label>
                                    <input type="tel" name="phoneNumber" class="form-control form-control-lg rounded-3" value="@Model.PhoneNumber" placeholder="เช่น 0812345678" />
                                </div>
                                <div class="col-12 mt-4">
                                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm">
                                        <i class="fa-solid fa-floppy-disk me-1"></i>บันทึกข้อมูลส่วนตัว
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="col-lg-4 mt-4 mt-lg-0 border-start ps-lg-4">
                        <h6 class="fw-bold text-secondary mb-3">สรุปข้อมูลบัญชี</h6>
                        <ul class="list-group list-group-flush small">
                            <li class="list-group-item d-flex justify-content-between px-0 py-2">
                                <span class="text-muted">วันที่สมัครสมาชิก</span>
                                <span class="fw-semibold text-dark">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") น.</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0 py-2">
                                <span class="text-muted">ประเภทผู้ใช้งาน</span>
                                <span class="badge bg-success bg-opacity-75">@Model.Role</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0 py-2">
                                <span class="text-muted">คำสั่งซื้อสะสม</span>
                                <span class="fw-semibold text-primary">@orderCount รายการ</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0 py-2">
                                <span class="text-muted">ที่อยู่จัดส่งที่บันทึก</span>
                                <span class="fw-semibold text-dark">@addresses.Count ที่อยู่</span>
                            </li>
                        </ul>
                    </div>
                </div>
            }

            <!-- ============================================== -->
            <!-- TAB 2: สมุดที่อยู่จัดส่ง (Address Book) -->
            <!-- ============================================== -->
            @if (currentTab == "address")
            {
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-1 text-dark">
                            <i class="fa-solid fa-address-book text-primary me-2"></i>สมุดที่อยู่จัดส่งสินค้า
                        </h5>
                        <p class="text-muted small mb-0">คุณสามารถบันทึกที่อยู่ได้หลายแห่ง และเลือกที่อยู่เริ่มต้นเพื่อให้ระบบเลือกอัตโนมัติตอนสั่งซื้อ</p>
                    </div>
                    <button type="button" class="btn btn-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addAddressModal">
                        <i class="fa-solid fa-plus me-1"></i>เพิ่มที่อยู่ใหม่
                    </button>
                </div>

                @if (!addresses.Any())
                {
                    <div class="text-center py-5 bg-light rounded-4 my-3">
                        <i class="fa-solid fa-map-location-dot fs-1 text-muted opacity-50 mb-3 d-block"></i>
                        <h6 class="fw-bold text-dark">ยังไม่มีที่อยู่จัดส่งที่บันทึกไว้</h6>
                        <p class="text-muted small mb-3">เพิ่มที่อยู่ของคุณเพื่อให้ขั้นตอนการสั่งซื้อสินค้ารวดเร็วและสะดวกยิ่งขึ้น</p>
                        <button type="button" class="btn btn-primary btn-sm rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addAddressModal">
                            <i class="fa-solid fa-plus me-1"></i>เพิ่มที่อยู่แรกของคุณ
                        </button>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var addr in addresses)
                        {
                            <div class="col-md-6">
                                <div class="card h-100 rounded-3 border @(addr.IsDefault ? "border-primary border-2 shadow-sm bg-primary bg-opacity-10" : "bg-white") p-3 position-relative">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0 d-inline-block">@addr.ReceiverName</h6>
                                            @if (addr.IsDefault)
                                            {
                                                <span class="badge bg-primary ms-2"><i class="fa-solid fa-check me-1"></i>ที่อยู่เริ่มต้น</span>
                                            }
                                        </div>
                                        <span class="text-muted small text-nowrap">
                                            <i class="fa-solid fa-phone me-1"></i>@addr.Phone
                                        </span>
                                    </div>

                                    <div class="text-secondary small mb-3" style="line-height: 1.6;">
                                        @addr.AddressLine<br />
                                        เขต/อำเภอ @addr.District จังหวัด @addr.Province<br />
                                        <strong class="text-dark">รหัสไปรษณีย์: @addr.PostalCode</strong>
                                    </div>

                                    <div class="mt-auto pt-2 border-top d-flex flex-wrap gap-2 justify-content-between align-items-center">
                                        <div>
                                            @if (!addr.IsDefault)
                                            {
                                                <form method="post" asp-action="SetDefaultAddress" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="addressId" value="@addr.AddressId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-2" title="ตั้งเป็นที่อยู่จัดส่งเริ่มต้น">
                                                        <i class="fa-solid fa-star me-1"></i>ตั้งเป็นค่าเริ่มต้น
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                        <div class="d-flex gap-1">
                                            <!-- ปุ่มแก้ไขที่อยู่ -->
                                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2"
                                                    data-bs-toggle="modal" data-bs-target="#editAddressModal_@addr.AddressId" title="แก้ไขที่อยู่">
                                                <i class="fa-solid fa-pen-to-square me-1"></i>แก้ไข
                                            </button>

                                            <!-- ปุ่มลบที่อยู่ -->
                                            <form method="post" asp-action="DeleteAddress" class="d-inline" onsubmit="return confirm('คุณต้องการลบที่อยู่นี้หรือไม่?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="addressId" value="@addr.AddressId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="ลบที่อยู่">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Modal แก้ไขที่อยู่ -->
                            <div class="modal fade" id="editAddressModal_@addr.AddressId" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content rounded-4 border-0 shadow">
                                        <form method="post" asp-action="EditAddress">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="AddressId" value="@addr.AddressId" />
                                            <div class="modal-header border-bottom py-3">
                                                <h6 class="modal-title fw-bold">
                                                    <i class="fa-solid fa-pen-to-square text-primary me-2"></i>แก้ไขที่อยู่จัดส่ง
                                                </h6>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body p-4">
                                                <div class="row g-3">
                                                    <div class="col-md-6">
                                                        <label class="form-label small fw-semibold">ชื่อ-นามสกุล ผู้รับ <span class="text-danger">*</span></label>
                                                        <input type="text" name="ReceiverName" class="form-control" value="@addr.ReceiverName" required />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label small fw-semibold">เบอร์โทรศัพท์ <span class="text-danger">*</span></label>
                                                        <input type="tel" name="Phone" class="form-control" value="@addr.Phone" required />
                                                    </div>
                                                    <div class="col-12">
                                                        <label class="form-label small fw-semibold">ที่อยู่ / บ้านเลขที่ / ซอย / ถนน <span class="text-danger">*</span></label>
                                                        <textarea name="AddressLine" rows="2" class="form-control" required>@addr.AddressLine</textarea>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label small fw-semibold">เขต / อำเภอ</label>
                                                        <input type="text" name="District" class="form-control" value="@addr.District" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label small fw-semibold">จังหวัด</label>
                                                        <input type="text" name="Province" class="form-control" value="@addr.Province" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label small fw-semibold">รหัสไปรษณีย์</label>
                                                        <input type="text" name="PostalCode" class="form-control" value="@addr.PostalCode" />
                                                    </div>
                                                    <div class="col-12">
                                                        <div class="form-check mt-1">
                                                            <input class="form-check-input" type="checkbox" name="IsDefault" value="true" id="editDef_@addr.AddressId" @(addr.IsDefault ? "checked" : "") />
                                                            <label class="form-check-label small" for="editDef_@addr.AddressId">
                                                                ตั้งเป็นที่อยู่จัดส่งเริ่มต้น
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer border-top-0 pt-0">
                                                <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">ยกเลิก</button>
                                                <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">บันทึกการแก้ไข</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }

            <!-- ============================================== -->
            <!-- TAB 3: เปลี่ยนรหัสผ่าน (Change Password) -->
            <!-- ============================================== -->
            @if (currentTab == "password")
            {
                <div class="row">
                    <div class="col-lg-7">
                        <h5 class="fw-bold mb-3 text-dark">
                            <i class="fa-solid fa-key text-primary me-2"></i>เปลี่ยนรหัสผ่านเข้าสู่ระบบ
                        </h5>
                        <form method="post" asp-action="ChangePassword">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label fw-semibold small">รหัสผ่านเดิม <span class="text-danger">*</span></label>
                                <input type="password" name="oldPassword" class="form-control form-control-lg rounded-3" placeholder="กรอกรหัสผ่านปัจจุบัน" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold small">รหัสผ่านใหม่ <span class="text-danger">*</span></label>
                                <input type="password" name="newPassword" class="form-control form-control-lg rounded-3" placeholder="อย่างน้อย 4 ตัวอักษร" minlength="4" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold small">ยืนยันรหัสผ่านใหม่ <span class="text-danger">*</span></label>
                                <input type="password" name="confirmPassword" class="form-control form-control-lg rounded-3" placeholder="กรอกรหัสผ่านใหม่อีกครั้ง" minlength="4" required />
                            </div>
                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm">
                                    <i class="fa-solid fa-lock me-1"></i>บันทึกรหัสผ่านใหม่
                                </button>
                            </div>
                        </form>
                    </div>
                    <div class="col-lg-5 mt-4 mt-lg-0 border-start ps-lg-4">
                        <div class="p-3 bg-light rounded-3">
                            <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-shield-halved text-success me-2"></i>ข้อแนะนำความปลอดภัย</h6>
                            <ul class="text-secondary small mb-0 ps-3">
                                <li class="mb-1">ใช้รหัสผ่านที่มีความยาวตั้งแต่ 4 ตัวอักษรขึ้นไป</li>
                                <li class="mb-1">หลีกเลี่ยงการใช้วันเดือนปีเกิดหรือเบอร์โทรศัพท์เป็นรหัสผ่าน</li>
                                <li class="mb-0">อย่าเปิดเผยรหัสผ่านกับผู้อื่นเพื่อความปลอดภัยของบัญชี</li>
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal เพิ่มที่อยู่ใหม่ -->
<div class="modal fade" id="addAddressModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form method="post" asp-action="AddAddress">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom py-3">
                    <h6 class="modal-title fw-bold">
                        <i class="fa-solid fa-plus-circle text-primary me-2"></i>เพิ่มที่อยู่จัดส่งใหม่
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">ชื่อ-นามสกุล ผู้รับ <span class="text-danger">*</span></label>
                            <input type="text" name="ReceiverName" class="form-control" placeholder="เช่น นายสมชาย ใจดี" value="@Model.FirstName @Model.LastName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">เบอร์โทรศัพท์ติดต่อ <span class="text-danger">*</span></label>
                            <input type="tel" name="Phone" class="form-control" placeholder="เช่น 0812345678" value="@Model.PhoneNumber" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">ที่อยู่ / บ้านเลขที่ / ซอย / ถนน <span class="text-danger">*</span></label>
                            <textarea name="AddressLine" rows="2" class="form-control" placeholder="เช่น 123/45 ซอยสุขุมวิท 55 ถนนสุขุมวิท" required></textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">เขต / อำเภอ</label>
                            <input type="text" name="District" class="form-control" placeholder="เช่น วัฒนา" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">จังหวัด</label>
                            <input type="text" name="Province" class="form-control" value="กรุงเทพมหานคร" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">รหัสไปรษณีย์</label>
                            <input type="text" name="PostalCode" class="form-control" placeholder="เช่น 10110" />
                        </div>
                        <div class="col-12">
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="checkbox" name="IsDefault" value="true" id="newIsDefault" @(!addresses.Any() ? "checked" : "") />
                                <label class="form-check-label small" for="newIsDefault">
                                    ตั้งเป็นที่อยู่จัดส่งเริ่มต้น
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
