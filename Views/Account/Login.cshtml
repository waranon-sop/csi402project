@model waranon_csi402_5008_Assessment4.Models.LoginViewModel
@{
    ViewData["Title"] = "เข้าสู่ระบบ";
    Layout = "_BlankLayout";
}

<link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-primary bg-gradient" style="font-family: 'Prompt', sans-serif;">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden mx-3" style="max-width: 450px; width: 100%;">

        <!-- Header -->
        <div class="card-header bg-primary bg-gradient text-white text-center py-5 border-0">
            <i class="fa-solid fa-shirt fs-1 mb-3 d-block"></i>
            <h2 class="fw-bold mb-1">เสื้อผ้า.com</h2>
            <p class="opacity-75 small mb-0">เข้าสู่ระบบเพื่อช้อปปิ้ง</p>
        </div>

        <!-- Body -->
        <div class="card-body p-4 p-md-5">
            <form asp-action="Login" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- อีเมล -->
                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control rounded-3" placeholder="อีเมล" id="inputEmail">
                    <label for="inputEmail"><i class="fa-solid fa-envelope me-2"></i>อีเมล</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <!-- รหัสผ่าน -->
                <div class="form-floating mb-3">
                    <input asp-for="Password" class="form-control rounded-3" placeholder="รหัสผ่าน" id="inputPassword">
                    <label for="inputPassword"><i class="fa-solid fa-lock me-2"></i>รหัสผ่าน</label>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <!-- จดจำฉัน & ลืมรหัสผ่าน -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" id="rememberMe">
                        <label class="form-check-label small" for="rememberMe">จดจำฉันไว้</label>
                    </div>
                    <a href="#" class="small text-primary text-decoration-none">ลืมรหัสผ่าน?</a>
                </div>

                <!-- ปุ่ม Login -->
                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-3 mb-2">
                    <i class="fa-solid fa-right-to-bracket me-2"></i>เข้าสู่ระบบ
                </button>
            </form>

            <!-- Social Login -->
            <div class="d-flex align-items-center my-4">
                <hr class="flex-grow-1">
                <span class="px-3 text-muted small">หรือเข้าสู่ระบบด้วย</span>
                <hr class="flex-grow-1">
            </div>
            <div class="row g-2">
                <div class="col-6">
                    <button class="btn btn-outline-secondary w-100 rounded-3 py-2"><i class="fab fa-google text-danger me-2"></i>Google</button>
                </div>
                <div class="col-6">
                    <button class="btn btn-outline-secondary w-100 rounded-3 py-2"><i class="fab fa-facebook-f text-primary me-2"></i>Facebook</button>
                </div>
            </div>
        </div>

        <!-- Register Link -->
        <div class="card-footer bg-light text-center py-3 border-top">
            ยังไม่มีบัญชี? <a asp-action="Register" asp-controller="Account" class="text-primary fw-semibold text-decoration-none">สมัครสมาชิก</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
