@model waranon_csi402.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "เข้าสู่ระบบ";
    Layout = "_BlankLayout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light"
     style="font-family: 'Prompt', sans-serif;">
    <div class="card shadow-lg border-0 rounded-4 p-4 mx-3" style="max-width: 450px; width: 100%;">

        <div class="text-center mb-4 mt-2">
            <h3 class="fw-bold text-primary">เข้าสู่ระบบ</h3>
        </div>

        <div class="card-body p-0">
            <form asp-controller="Account" asp-action="Login" method="post">
                <!-- ซ่อนข้อมูลที่รับมาจากหน้า Register เพื่อส่งต่อไปตอนกดปุ่ม Login -->
                <input type="hidden" name="FirstName" value="@ViewBag.FirstName" />
                <input type="hidden" name="LastName" value="@ViewBag.LastName" />
                <input type="hidden" name="PhoneNumber" value="@ViewBag.PhoneNumber" />

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold text-secondary small">อีเมล </label>
                    <input asp-for="Email" class="form-control form-control-lg bg-light border-0" required />
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label fw-semibold text-secondary small">รหัสผ่าน </label>
                    <input asp-for="Password" class="form-control form-control-lg bg-light border-0" required />
                </div>
                

                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 fw-bold shadow-sm mb-3">
                    เข้าสู่ระบบ
                </button>
            </form>

            <div class="text-center">
                <span class="text-muted small">ยังไม่มีบัญชีใช่หรือไม่?</span>
                <a asp-action="Register" asp-controller="Account"
                   class="text-decoration-none fw-semibold">สมัครสมาชิก</a>
            </div>
        </div>

    </div>
</div>

