@model waranon_csi402_5008_Assessment4.Models.RegisterViewModel
@{
    ViewData["Title"] = "สมัครสมาชิก";
    Layout = "_BlankLayout";
}

<link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-danger bg-gradient py-5" style="font-family: 'Prompt', sans-serif;">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden mx-3" style="max-width: 500px; width: 100%;">

        <!-- Header -->
        <div class="card-header bg-danger bg-gradient text-white text-center py-5 border-0">
            <i class="fa-solid fa-user-plus fs-1 mb-3 d-block"></i>
            <h2 class="fw-bold mb-1">สมัครสมาชิก</h2>
            <p class="opacity-75 small mb-0">เข้าร่วมเป็นครอบครัว เสื้อผ้า.com</p>
        </div>

        <!-- Body -->
        <div class="card-body p-4 p-md-5">
            <form asp-action="Register" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- ชื่อ-นามสกุล -->
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="form-floating">
                            <input asp-for="FirstName" class="form-control rounded-3" placeholder="ชื่อ" id="inputFirstName">
                            <label for="inputFirstName"><i class="fa-solid fa-user me-2"></i>ชื่อ</label>
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-floating">
                            <input asp-for="LastName" class="form-control rounded-3" placeholder="นามสกุล" id="inputLastName">
                            <label for="inputLastName">นามสกุล</label>
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- อีเมล -->
                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control rounded-3" placeholder="อีเมล" id="inputEmail">
                    <label for="inputEmail"><i class="fa-solid fa-envelope me-2"></i>อีเมล</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <!-- เบอร์โทรศัพท์ -->
                <div class="form-floating mb-3">
                    <input asp-for="PhoneNumber" class="form-control rounded-3" placeholder="เบอร์โทรศัพท์" id="inputPhone">
                    <label for="inputPhone"><i class="fa-solid fa-phone me-2"></i>เบอร์โทรศัพท์</label>
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <!-- รหัสผ่าน -->
                <div class="form-floating mb-3">
                    <input asp-for="Password" class="form-control rounded-3" placeholder="รหัสผ่าน" id="inputPassword">
                    <label for="inputPassword"><i class="fa-solid fa-lock me-2"></i>รหัสผ่าน</label>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <!-- ยืนยันรหัสผ่าน -->
                <div class="form-floating mb-3">
                    <input asp-for="ConfirmPassword" class="form-control rounded-3" placeholder="ยืนยันรหัสผ่าน" id="inputConfirmPassword">
                    <label for="inputConfirmPassword"><i class="fa-solid fa-lock me-2"></i>ยืนยันรหัสผ่าน</label>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <!-- เงื่อนไข -->
                <div class="form-check mb-4">
                    <input asp-for="AgreeTerms" class="form-check-input" id="agreeTerms">
                    <label class="form-check-label small" for="agreeTerms">
                        ฉันยอมรับ <a href="#" class="text-danger text-decoration-none">เงื่อนไขการใช้งาน</a> และ <a href="#" class="text-danger text-decoration-none">นโยบายความเป็นส่วนตัว</a>
                    </label>
                    <br>
                    <span asp-validation-for="AgreeTerms" class="text-danger small"></span>
                </div>

                <!-- ปุ่มสมัคร -->
                <button type="submit" class="btn btn-danger w-100 py-2 fw-semibold rounded-3">
                    <i class="fa-solid fa-user-plus me-2"></i>สมัครสมาชิก
                </button>
            </form>
        </div>

        <!-- Login Link -->
        <div class="card-footer bg-light text-center py-3 border-top">
            มีบัญชีอยู่แล้ว? <a asp-action="Login" asp-controller="Account" class="text-danger fw-semibold text-decoration-none">เข้าสู่ระบบ</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
