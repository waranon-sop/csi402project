@model waranon_csi402.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "สมัครสมาชิก";
    Layout = "_BlankLayout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light py-5"
     style="font-family: 'Prompt', sans-serif;">
    <div class="card shadow-lg border-0 rounded-4 p-4 mx-3" style="max-width: 500px; width: 100%;">

        <div class="text-center mb-4 mt-2">
            <h3 class="fw-bold text-success">สมัครสมาชิก</h3>
        </div>

        <div class="card-body p-0">
            <form asp-controller="Account" asp-action="Register" method="post">
                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="FirstName" class="form-label fw-semibold text-secondary small">ชื่อ </label>
                        <input asp-for="FirstName" class="form-control bg-light border-0" required />
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="LastName" class="form-label fw-semibold text-secondary small">นามสกุล</label>
                        <input asp-for="LastName" class="form-control bg-light border-0" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold text-secondary small">อีเมล</label>
                    <input asp-for="Email" class="form-control bg-light border-0" required />
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label fw-semibold text-secondary small">เบอร์โทรศัพท์</label>
                    <input asp-for="PhoneNumber" class="form-control bg-light border-0" required />
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label fw-semibold text-secondary small">รหัสผ่าน</label>
                    <input asp-for="Password" class="form-control bg-light border-0" required />
                </div>
                
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold text-secondary small">ยืนยันรหัสผ่าน</label>
                    <input asp-for="ConfirmPassword" class="form-control bg-light border-0" required />
                </div>
                

                <button type="submit" class="btn btn-success btn-lg w-100 rounded-3 fw-bold shadow-sm mb-3">
                    สมัครสมาชิก
                </button>
            </form>

            <div class="text-center">
                <span class="text-muted small">มีบัญชีอยู่แล้วใช่หรือไม่?</span>
                <a asp-action="Login" asp-controller="Account"
                   class="text-success text-decoration-none fw-semibold">เข้าสู่ระบบ</a>
            </div>
        </div>

    </div>
</div>

